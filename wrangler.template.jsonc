{
  // Template for a provisioned instance. `shopctl provision --env <env>` fills
  // the __…__ placeholders from the client manifest and renders this to
  // ./wrangler.jsonc; scripts/prepare-client.mjs does the same for a build that
  // never reaches an account, and scripts/provision-cf.sh for the single-instance
  // path. Keep shared runtime settings in sync with wrangler.jsonc; bindings
  // intentionally differ because this template defaults to free-plan resources.
  //
  // FREE-PLAN DEFAULT: only D1 + R2 — both included on the Cloudflare free plan.
  // Every other integration degrades gracefully when its binding is absent; add a
  // binding back (+ redeploy) to enable the feature:
  //   • Semantic search — add  "ai": { "binding": "AI" }  and
  //     "vectorize": [{ "binding": "VECTORIZE", "index_name": "<name>-products" }]
  //     (create the index first: wrangler vectorize create <name>-products
  //     --dimensions=768 --metric=cosine),
  //     then flip it on in Admin → Settings → Search. Until then: keyword (FTS5).
  //   • Image optimize-on-upload — add "images": { "binding": "IMAGES" }, set
  //     images.optimizeOnUpload in src/store.config.ts, and redeploy. Without the
  //     binding, uploads are stored as-is in R2.
  //   • Cloudflare-native email — add  "send_email": [{ "name": "EMAIL" }]  (Workers
  //     PAID plan + onboarded sender domain). Resend (HTTP) works on the free plan
  //     and is configured entirely in Admin → Settings → Email.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "__NAME__",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat"],
  // Recurring jobs (handler: src/worker.ts) — retries queued notifications and
  // releases expired inventory holds without waiting for the next shopper.
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true, "traces": { "enabled": true, "head_sampling_rate": 1 } },
  // The custom production domain, from cloudflare.productionDomain in the client
  // manifest. `shopctl provision --env production` renders it as a route and
  // turns workers.dev OFF at the same time: two doors into the same shop means
  // an origin the merchant never advertised, indexed by search engines, outside
  // whatever Access sits on the real one. Staging and every account-free render
  // get an empty route list and keep workers.dev, which is how they are reached
  // at all.
  "workers_dev": __WORKERS_DEV__,
  "routes": __ROUTES__,
  // Fresh instances begin on workers.dev and therefore stay uncached. A later
  // custom-domain config may enable this only alongside CANONICAL_ORIGIN and
  // workers_dev: false. cross_version_cache additionally requires a shared
  // CACHE_PURGE_SECRET so scripts/deploy.mjs can purge after every deploy.
  "cache": { "enabled": false },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "10001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "CHECKOUT_RATE_LIMITER",
      "namespace_id": "10002",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "SEARCH_RATE_LIMITER",
      "namespace_id": "10003",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "__DB_NAME__",
      "database_id": "__DB_ID__",
      "migrations_dir": "migrations"
    }
  ],
  // The jurisdiction is repeated on every binding, and it is not decoration: a
  // bucket created with `--jurisdiction eu` (ADR 0004) lives in a namespace a
  // plain binding cannot see. Omit it and the deploy SUCCEEDS — the Worker
  // simply boots with a bucket that answers as if it were empty, which is the
  // worst shape this mistake could take.
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "__BUCKET__", "jurisdiction": "__JURISDICTION__" },
    // Private deliverables: never enable r2.dev or attach a custom domain.
    { "binding": "FILES", "bucket_name": "__FILES_BUCKET__", "jurisdiction": "__JURISDICTION__" }
  ],
  "vars": {
    // Defaults until the first-run wizard writes the real values to D1. The
    // store name is the manifest's client.displayName, which the wizard then
    // proposes; the time zone is the core's.
    "STORE_NAME": "__STORE_NAME__",
    "TIME_ZONE": "Europe/Paris",
    // Serve product images from an R2 custom domain (bypasses the Worker /images
    // route and unlocks on-demand delivery in Admin), from cloudflare.imagesDomain
    // in the client manifest. Empty is the ordinary case and never wrong: images
    // go through the Worker, which is slower and always correct. Attach the
    // domain to the images bucket first — `shopctl provision` reports which
    // domains it finds.
    "IMAGE_BASE_URL": "__IMAGE_BASE_URL__",
    // The Cloudflare Access application in front of a private preview, from
    // cloudflare.stagingAccessTeam / stagingAccessAud in the client manifest:
    // the admin gate verifies every Access assertion against them
    // (src/middleware.ts). Rendered on staging only, and only with a
    // stagingDomain; empty means no Access, which is every other render.
    "CF_ACCESS_TEAM_DOMAIN": "__ACCESS_TEAM_DOMAIN__",
    "CF_ACCESS_AUD": "__ACCESS_AUD__",
    // The environment this render is for: "production", "staging", or empty for
    // a render that reaches no account (a witness build, local development).
    // Production takes live Stripe payments only and staging test ones only
    // (src/features/payments/stripeMode.ts): a test key in production would let
    // a test card place an order.
    "MINSHOP_ENV": "__ENVIRONMENT__"
    //
    // This store's MCP endpoint, if you deployed the optional mcp/ Worker.
    // llms.txt advertises it to agents only when set — leave it unset and
    // nothing is advertised, rather than pointing at an endpoint that is not
    // there. See README → MCP server.
    // "MCP_URL": "https://your-mcp-host/mcp"
  }
}
