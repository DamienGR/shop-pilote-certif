---
import { formatPrice } from '../config';
import type { DailyTotal } from '../features/orders/db';
import { formatDateTime, t, tn } from '../features/i18n';

interface Props {
  data: DailyTotal[];
}

const { data } = Astro.props;

// SVG drawn in viewBox units (1 per day wide), stretched to fill via
// preserveAspectRatio="none". Plain rects stretch cleanly — no JS, no rounded
// corners to distort.
const H = 100;
const n = Math.max(data.length, 1);
const max = Math.max(1, ...data.map((d) => d.total_cents));
const total = data.reduce((s, d) => s + d.total_cents, 0);
const orders = data.reduce((s, d) => s + d.orders, 0);
// `day` is a UTC calendar date (YYYY-MM-DD), so it is read as UTC midnight and
// formatted in UTC: the store's zone must not move a bar to the previous day.
const asDate = (day: string) => new Date(`${day}T00:00:00Z`);
const dm = (day: string) => formatDateTime(asDate(day), { day: '2-digit', month: '2-digit' }, 'UTC');
const longDay = (day: string) => formatDateTime(asDate(day), { dateStyle: 'medium' }, 'UTC');
const ordersLabel = (count: number) =>
  tn('admin.dashboard.chart.orders.one', 'admin.dashboard.chart.orders.other', count);
---

<div>
  <div class="mb-3 flex items-baseline justify-between">
    <h2 class="text-xs uppercase tracking-widest text-faint">
      {t('admin.dashboard.chart.heading', { nombre: data.length })}
    </h2>
    <span class="text-xs text-faint">
      {formatPrice(total)} &middot; {ordersLabel(orders)}
    </span>
  </div>

  <svg
    viewBox={`0 0 ${n} ${H}`}
    preserveAspectRatio="none"
    class="h-40 w-full"
    role="img"
    aria-label={t('admin.dashboard.chart.label', { nombre: data.length })}
  >
    {
      data.map((d, i) => {
        const h = (d.total_cents / max) * H;
        return (
          <rect x={i + 0.12} y={H - h} width={0.76} height={h} class="fill-brand">
            <title>{t('admin.dashboard.chart.bar', { jour: longDay(d.day), montant: formatPrice(d.total_cents), commandes: ordersLabel(d.orders) })}</title>
          </rect>
        );
      })
    }
  </svg>

  <div class="mt-2 flex justify-between text-xs tabular-nums text-faint">
    <span>{data[0] && dm(data[0].day)}</span>
    <span>{data[data.length - 1] && dm(data[data.length - 1].day)}</span>
  </div>
</div>
