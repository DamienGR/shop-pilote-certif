---
import type { Product } from './db';
import type { CategoryOption } from '../categories/db';
import { getConfig, toMajorUnits, currencyDecimals } from '../../config';
import { formatWeightValue, type WeightUnit } from '../shipping/weight';
import { attachmentActive } from '../digitalDelivery/rollout.ts';
import { t, formatNumber } from '../i18n';

interface Props {
  action: string;
  submitLabel: string;
  product?: Product | null;
  error?: string | null;
  /** Depth-tagged categories to choose from (empty = no categories yet). */
  categoryOptions?: CategoryOption[];
  /** Ids of categories this product currently belongs to. */
  selectedCategoryIds?: number[];
  /** Show the single-image upload (true on create; edit uses the gallery). */
  showImage?: boolean;
  /** Optional form id, so out-of-tree inputs (e.g. the variants editor) can submit
      with this form via the HTML `form="..."` attribute. */
  formId?: string;
  /** Store-wide weight unit (Admin → Réglages). Storage is always grams. */
  weightUnit?: WeightUnit;
  /** True when every enabled zone prices by weight, so a blank weight would make
   *  this product unsellable. Shown as a requirement rather than discovered later. */
  weightRequired?: boolean;
}

const {
  action,
  submitLabel,
  product = null,
  error = null,
  categoryOptions = [],
  selectedCategoryIds = [],
  showImage = true,
  formId,
  weightUnit = 'g',
  weightRequired = false,
} = Astro.props;
const selected = new Set(selectedCategoryIds);
// New products default to the store currency; edits keep their own.
const defaultCurrency = product?.currency ?? getConfig().currency;
const priceDecimals = currencyDecimals(defaultCurrency);
const price = product
  ? toMajorUnits(product.price_cents, product.currency).toFixed(currencyDecimals(product.currency))
  : '';
// Input increment matches the currency's precision: 0.01 (USD), 1 (JPY), 0.001 (BHD).
const priceStep = priceDecimals > 0 ? (10 ** -priceDecimals).toFixed(priceDecimals) : '1';
const inputClass =
  'mt-1 w-full rounded-md border border-line px-3 py-2 focus:border-brand focus:outline-none';
---

<form
  method="POST"
  action={action}
  enctype="multipart/form-data"
  id={formId}
  class="max-w-lg space-y-4"
>
  {
    error && (
      <p class="rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
        {error}
      </p>
    )
  }

  <div>
    <label class="block text-sm font-medium" for="name">{t('admin.common.name')}</label>
    <input id="name" name="name" type="text" required value={product?.name ?? ''} class={inputClass} />
  </div>

  <div>
    <label class="block text-sm font-medium" for="slug">
      Slug <span class="text-faint">{t('admin.products.form.slugHint')}</span>
    </label>
    <input
      id="slug"
      name="slug"
      type="text"
      value={product?.slug ?? ''}
      placeholder={t('admin.products.form.slugPlaceholder')}
      class={inputClass}
    />
  </div>

  <div>
    <label class="block text-sm font-medium" for="sku">
      {t('admin.products.form.sku')} <span class="text-faint">{t('admin.products.form.skuHint')}</span>
    </label>
    <input
      id="sku"
      name="sku"
      type="text"
      value={product?.sku ?? ''}
      placeholder={t('admin.products.form.skuPlaceholder')}
      class={inputClass}
    />
  </div>

  <div>
    <label class="block text-sm font-medium" for="description">{t('admin.products.form.description')}</label>
    <textarea id="description" name="description" rows="3" class={inputClass}
      >{product?.description ?? ''}</textarea>
      <p class="mt-1 text-xs text-gray-500">{t('admin.products.form.descriptionHint.before')} <code>/images/…</code> {t('admin.products.form.descriptionHint.after')}</p>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium" for="price">{t('admin.products.form.price', { devise: defaultCurrency.toUpperCase() })}</label>
      <input id="price" name="price" type="number" step={priceStep} min="0" required value={price} class={inputClass} />
    </div>
    <div>
      <label class="block text-sm font-medium" for="stock">{t('admin.products.form.stock')}</label>
      <input id="stock" name="stock" type="number" step="1" min="0" value={product?.stock ?? 0} class={inputClass} />
    </div>
  </div>

  {attachmentActive() && <fieldset class="rounded-md border border-line p-4">
    <legend class="px-1 text-sm font-medium">{t('admin.products.form.shipping')}</legend>
    <label class="flex items-center gap-2 text-sm">
      <input
        name="requires_shipping"
        type="checkbox"
        checked={product ? product.requires_shipping === 1 : true}
        class="h-4 w-4"
      />
      {t('admin.products.form.requiresShipping')}
    </label>
    <p class="mt-1 text-xs text-muted">
      {t('admin.products.form.requiresShippingHint')}
    </p>
    <div class="mt-3">
      <label class="block text-sm font-medium" for="weight">{t('admin.products.form.weight', { unite: weightUnit })}</label>
      <input
        id="weight"
        name="weight"
        type="text"
        inputmode="decimal"
        value={product?.weight_grams != null ? formatWeightValue(product.weight_grams, weightUnit) : ''}
        class={inputClass}
      />
      <p class="mt-1 text-xs text-muted">
        {t('admin.products.form.weightHint')}
        {weightRequired
          ? t('admin.products.form.weightRequired')
          : t('admin.products.form.weightOptional')}
      </p>
    </div>
  </fieldset>}

  <fieldset class="rounded-md border border-line p-4">
    <legend class="px-1 text-sm font-medium">{t('admin.products.form.digital')}</legend>
    {product?.file_key && (
      <p class="mb-3 text-sm text-muted">
        {t('admin.products.form.attached')} <strong>{product.file_name ?? t('admin.products.form.fileFallbackName')}</strong>
        {product.file_size_bytes != null &&
          ` (${t('admin.products.form.fileSize', { taille: formatNumber(Math.ceil(product.file_size_bytes / 1024)) })})`}
      </p>
    )}
    <label class="block text-sm font-medium" for="deliverable">{product?.file_key ? t('admin.products.form.replaceFile') : t('admin.products.form.attachFile')}</label>
    <input
      id="deliverable"
      name="deliverable"
      type="file"
      accept=".pdf,.zip,.epub,.mp3,.m4a,.txt"
      class="mt-1 block w-full text-sm text-muted"
    />
    <p class="mt-1 text-xs text-muted">{t('admin.products.form.digitalHint.before')} <strong>{t('admin.products.form.requiresShipping')}</strong> {t('admin.products.form.digitalHint.after')}</p>
    {product?.file_key && (
      <label class="mt-3 flex items-center gap-2 text-sm">
        <input type="checkbox" name="remove_deliverable" class="h-4 w-4" />
        {t('admin.products.form.removeFile')}
      </label>
    )}
  </fieldset>

  {
    showImage && (
      <div>
        <label class="block text-sm font-medium" for="image">
          {t('admin.products.form.image')}
        </label>
        <input id="image" name="image" type="file" accept="image/*" class="mt-1 block w-full text-sm text-muted file:mr-3 file:cursor-pointer file:rounded-md file:border-0 file:bg-brand file:px-4 file:py-2 file:text-xs file:font-medium file:uppercase file:tracking-wider file:text-on-brand hover:file:bg-brand-hover" />
      </div>
    )
  }

  {
    categoryOptions.length > 0 && (
      <fieldset>
        <legend class="block text-sm font-medium">{t('admin.products.form.categories')}</legend>
        <div class="mt-1 max-h-48 space-y-1 overflow-auto rounded-md border border-line p-2">
          {categoryOptions.map((c) => (
            <label
              class="flex items-center gap-2 text-sm"
              style={`padding-left:${c.depth * 16}px`}
            >
              {/* cat_ public IDs — resolved back to row ids server-side. */}
              <input
                type="checkbox"
                name="category"
                value={c.public_id}
                checked={selected.has(c.id)}
                class="h-4 w-4"
              />
              {c.name}
            </label>
          ))}
        </div>
      </fieldset>
    )
  }

  <label class="flex items-center gap-2 text-sm">
    <input name="active" type="checkbox" checked={product ? product.active === 1 : true} class="h-4 w-4" />
    {t('admin.products.form.active')}
  </label>

  <input type="hidden" name="currency" value={defaultCurrency} />

  <div class="flex gap-3 pt-2">
    <button type="submit" class="rounded-md bg-brand px-5 py-2 font-medium text-on-brand hover:bg-brand-hover">
      {submitLabel}
    </button>
    <a href="/admin/products" class="rounded-md border border-line px-5 py-2 hover:bg-surface">{t('admin.common.cancel')}</a>
  </div>
</form>
