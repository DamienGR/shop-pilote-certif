---
import type { StorefrontGalleryImage, StorefrontImage } from '../models';
import StoreImage from './StoreImage.astro';
import { t } from '../../i18n';

/**
 * The product hero: a snap-scrolling gallery when there is more than one image,
 * a single image otherwise.
 *
 * `data-product-hero` marks the hero in BOTH forms; `data-hero-track` exists
 * only in the gallery. A check that looked for the track missed every product
 * with one image — on a real catalogue, most of them.
 *
 * Owns the anchor ids the thumbnails and the variant selector scroll to, and
 * the LCP treatment on the first frame — eager and high priority, with every
 * later frame lazy. Both are easy to lose when restyling and invisible when
 * they go missing.
 *
 * The priority frame is never faded, for the same reason StoreImage refuses the
 * combination: an opacity:0 element is not a valid LCP candidate, so fading it
 * holds the paint back until load and undoes the head start `priority` bought.
 */
interface Props {
  images: StorefrontGalleryImage[];
  hero: StorefrontImage;
  soldOut: boolean;
  soldOutLabel?: string;
  class?: string;
}

const {
  images,
  hero,
  soldOut,
  soldOutLabel = t('product.soldOut'),
  class: className = '',
} = Astro.props;
const hasGallery = images.length > 1;
---

{
  hasGallery ? (
    <div class={className} data-product-hero>
      {/* `tabindex="0"` is not decoration: the track scrolls horizontally, and a
          region that scrolls but cannot take focus is unreachable to anyone
          driving the page from the keyboard — the images past the first simply
          do not exist for them. The label comes with it, because a focus stop
          that announces nothing is its own problem. */}
      <div
        data-hero-track
        tabindex="0"
        role="group"
        aria-label={t('product.gallery')}
        class="no-scrollbar relative flex snap-x snap-mandatory overflow-x-auto scroll-smooth rounded-lg bg-surface"
      >
        {images.map((image) => (
          <img
            id={`pi-${image.anchor}`}
            src={image.hero.src}
            srcset={image.hero.srcset}
            sizes={image.hero.sizes}
            alt={image.hero.alt}
            width="800"
            height="800"
            loading={image.hero.priority ? 'eager' : 'lazy'}
            fetchpriority={image.hero.priority ? 'high' : 'auto'}
            decoding="async"
            {...(image.hero.priority ? {} : { 'data-image-fade': '' })}
            class={`aspect-square w-full shrink-0 snap-center bg-surface object-cover${soldOut ? ' opacity-60' : ''}`}
          />
        ))}
        {soldOut && (
          <span class="absolute left-4 top-4 rounded-full bg-surface/90 px-3 py-1 text-xs uppercase tracking-widest text-muted ring-1 ring-line">
            {soldOutLabel}
          </span>
        )}
      </div>
      <div class="no-scrollbar mt-3 flex gap-2 overflow-x-auto">
        {/* The thumbnail is decorative — the hero above carries the content, so
            alt stays empty — but the LINK still needs a name, or a screen
            reader announces a row of anonymous "link"s. Positional rather than
            the product name: every thumbnail on this page shows the same
            product, so the name would label them all identically. */}
        {images.map((image, index) => (
          <a
            href={`#pi-${image.anchor}`}
            aria-label={t('product.gallery.image', {
              position: String(index + 1),
              total: String(images.length),
            })}
            class="shrink-0 overflow-hidden rounded border border-line bg-surface transition hover:border-brand"
          >
            <img
              src={image.thumbnail.src}
              srcset={image.thumbnail.srcset}
              sizes={image.thumbnail.sizes}
              alt=""
              width="64"
              height="64"
              loading="lazy"
              decoding="async"
              data-image-fade
              class="h-16 w-16 bg-surface object-cover"
            />
          </a>
        ))}
      </div>
    </div>
  ) : (
    <div class={`${className} relative overflow-hidden rounded-lg bg-surface`.trim()} data-product-hero>
      <StoreImage
        image={hero}
        fade
        class={`aspect-square w-full bg-surface object-cover${soldOut ? ' opacity-60' : ''}`}
      />
      {soldOut && (
        <span class="absolute left-4 top-4 rounded-full bg-surface/90 px-3 py-1 text-xs uppercase tracking-widest text-muted ring-1 ring-line">
          {soldOutLabel}
        </span>
      )}
    </div>
  )
}
