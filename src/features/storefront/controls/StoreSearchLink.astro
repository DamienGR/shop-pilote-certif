---
import { t } from '../../i18n';
/**
 * The search link a header shows where its search field does not fit: a
 * magnifier, named for screen readers. Themes hide it above the breakpoint
 * where the field appears; below it, every letter of the row is the store
 * name's (certification, étape 9).
 */
interface Props {
  href: string;
  class?: string;
}

const { href, class: className = 'hover:text-brand' } = Astro.props;
---

<a href={href} class={className}>
  <span class="inline-flex h-6 w-6 items-center justify-center" aria-hidden="true">
    <svg
      width="20"
      height="20"
      viewBox="0 0 20 20"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
    >
      <circle cx="8.5" cy="8.5" r="5.5" />
      <path d="m12.5 12.5 5 5" />
    </svg>
  </span>
  <span class="sr-only">{t('shell.search.link')}</span>
</a>
