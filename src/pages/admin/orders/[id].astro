---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { formatPrice, formatDate, getConfig } from '../../../config';
import { getOrderByPublicId, listOrderItemsWithImages, listOrderInventoryExceptions } from '../../../features/orders/db';
import { orderReference } from '../../../features/orders/number';
import { CARRIERS, carrierName, orderTrackingUrl } from '../../../features/orders/tracking';
import { getEmailProvider } from '../../../features/email';
import { getStoreSettings } from '../../../features/settings/db';
import { getSetting } from '../../../features/settings/db';
import { formatWeightValue } from '../../../features/shipping/weight';
import {
  getLabelRecord,
  isPurchaseStale,
  listLabelAttempts,
} from '../../../features/shipping/labelStore';
import { getBoxtalLabelContext } from '../../../features/shipping/boxtal/index.ts';
import { relayOffer } from '../../../features/shipping/boxtal/offers.ts';
import { orderRelayPoint, relayPointLines } from '../../../features/shipping/relay.ts';
import {
  parseQuotedOffers,
  parseSender,
  splitName,
  type LabelSender,
} from '../../../features/shipping/boxtal/orderLabel.ts';
import { shouldSendCustomerOrderEmail } from '../../../features/email/orderPolicy';
import RefundPanel from '../../../features/refunds/RefundPanel.astro';
import { formatWeight } from '../../../features/shipping/weight';
import { parseOrderOrLegacyPublicId } from '../../../features/ids/publicId';
import { t, type MessageKey } from '../../../features/i18n';

// The route param is the order public ID — ord_ or a preserved legacy shape
// (hex32/UUID). Numeric row ids are not accepted.
const publicId = parseOrderOrLegacyPublicId(Astro.params.id, 'order');
const order = publicId ? await getOrderByPublicId(env.DB, publicId) : null;

if (!order) {
  return new Response(t('admin.orders.notFound'), { status: 404 });
}

// The token portion of ord_ IDs; legacy orders keep their calculated number.
const num = orderReference(order.public_id, order.id, getConfig().orderNumber);
// Human label for the rail the order was paid on (NULL = legacy/unknown).
const PAYMENT_LABELS: Record<string, MessageKey> = {
  stripe: 'admin.orders.method.stripe',
  lightning: 'admin.orders.method.lightning',
  opennode: 'admin.orders.method.opennode',
  demo: 'admin.orders.method.demoNoCharge',
};
const paymentLabel = order.payment_method
  ? (PAYMENT_LABELS[order.payment_method] ? t(PAYMENT_LABELS[order.payment_method]) : order.payment_method)
  : '—';
// orders.status holds pending | paid | refunded; an unknown value shows as is.
const STATUS_LABELS: Record<string, MessageKey> = {
  paid: 'admin.orders.status.paid',
  pending: 'admin.orders.status.pending',
  refunded: 'admin.orders.status.refunded',
};
const statusLabel = STATUS_LABELS[order.status] ? t(STATUS_LABELS[order.status]) : order.status;
// Label-attempt outcomes are LabelAttemptOutcome codes; a newer one shows as is.
const OUTCOME_LABELS: Record<string, MessageKey> = {
  purchased: 'admin.orders.detail.labelHistory.purchased',
  refunded: 'admin.orders.detail.labelHistory.refunded',
  failed: 'admin.orders.detail.labelHistory.failed',
  force_discarded: 'admin.orders.detail.labelHistory.forceDiscarded',
};
const outcomeLabel = (outcome: string) =>
  OUTCOME_LABELS[outcome] ? t(OUTCOME_LABELS[outcome]) : outcome;
const timeZone = Astro.locals.settings?.timeZone ?? getConfig().timeZone;
const items = await listOrderItemsWithImages(env.DB, order.id);
const inventoryExceptions = await listOrderInventoryExceptions(env.DB, order.id);
const fulfilled = order.fulfillment_status === 'fulfilled';
const weightUnit = Astro.locals.settings?.weightUnit ?? 'g';

// ── Shipping label (Boxtal) ──────────────────────────────────────────────────
// Gated on Boxtal's keys (a shop without them ships by hand, as before: ADR
// 0020) and on the order being a paid, unfulfilled DELIVERY order — pickup
// orders have no parcel to send. All label state lives in this order's
// shipping_labels row; the page never reads a reference from the URL, so
// another order's quote cannot be spliced in. Offers render on a plain GET,
// so the flow needs no JS.
const boxtal = await getBoxtalLabelContext(env.DB, order.currency);
const boxtalSettings = boxtal?.settings ?? null;
// The label record is loaded unconditionally: a purchased label whose order
// refused fulfillment (refund mid-purchase, forced manual fulfil) is money
// already spent, and it must stay visible on fulfilled/refunded orders — even
// if the keys were removed.
const labelRecord = await getLabelRecord(env.DB, order.id);
const labelAttempts = await listLabelAttempts(env.DB, order.id);
const labelEligible =
  !!order.ship_address &&
  !fulfilled &&
  order.status === 'paid' &&
  // Exactly 'shipping' or 'relay': pickup orders have no parcel, and 'unknown'
  // (a Stripe settlement that lost the rate lookup) must be reconciled, not
  // guessed at. 0036 backfilled legacy physical orders, so NULL here really
  // means unknown.
  (order.delivery_method === 'shipping' || order.delivery_method === 'relay');
// Keys alone are not enough: a label needs an offer to buy and a declared
// content. A relay order brings its offer with its point.
const labelSettingsReady =
  !!boxtalSettings &&
  (order.delivery_method === 'relay' || boxtalSettings.offers.length > 0) &&
  !!boxtalSettings.contentId;
const canLabel = !!boxtal && labelSettingsReady && labelEligible;
const boxtalLabel = labelRecord?.vendor === 'boxtal';
const quoted =
  canLabel && boxtalLabel && labelRecord?.status === 'quoted' ? parseQuotedOffers(labelRecord.offers) : null;
// A purchasing row inside its lease has a live request behind it: show progress,
// allow nothing. Past the lease it is a crash mid-flight — the same human
// settlement as an ambiguous outcome.
const labelInFlight = labelRecord?.status === 'purchasing' && !isPurchaseStale(labelRecord);
const labelUncertain =
  labelRecord?.status === 'uncertain' ||
  (labelRecord?.status === 'purchasing' && isPurchaseStale(labelRecord));
// Bought, and Boxtal has not confirmed it yet: the number comes on a re-read.
const labelAwaitingTracking =
  boxtalLabel && labelRecord?.status === 'purchased' && !labelRecord.tracking_number && !fulfilled;
// Paid for but not what the order shows: the order refused fulfillment (refund
// mid-purchase) or was fulfilled another way. Rendered persistently — this must
// survive the transient redirect notice.
const labelUnreconciled =
  labelRecord?.status === 'purchased' &&
  (labelRecord.tracking_number
    ? order.tracking_number !== labelRecord.tracking_number || order.label_url !== labelRecord.label_url
    : fulfilled);
// A Boxtal label is read again on each download (ADR 0021); a Shippo one kept its URL.
const labelHref =
  labelRecord?.status === 'purchased'
    ? boxtalLabel
      ? `/api/admin/orders/${order.public_id}/label`
      : labelRecord.label_url
    : null;
const orderLabelHref =
  order.label_url ??
  (boxtalLabel && labelRecord?.status === 'purchased' && labelRecord.tracking_number === order.tracking_number
    ? labelHref
    : null);
let shipFrom: Partial<LabelSender> = {};
let parcelDefault: Partial<{ length: number; width: number; height: number }> = {};
if (canLabel) {
  shipFrom = parseSender(await getSetting(env.DB, 'ship_from'));
  try {
    parcelDefault = JSON.parse((await getSetting(env.DB, 'parcel_default')) ?? '{}');
  } catch {}
}
const parcelWeightValue =
  order.shipping_weight_grams != null ? formatWeightValue(order.shipping_weight_grams, weightUnit) : '';

const trackUrl = orderTrackingUrl(order);
const error = Astro.url.searchParams.get('error');
const noticeMsg = Astro.url.searchParams.get('notice');
// Reissue is offered only where it can work: a settled ord_ order with an
// email on a rail that sends customer email. The token itself is never shown.
const canReissue =
  !!order.email &&
  !!order.public_id?.startsWith('ord_') &&
  shouldSendCustomerOrderEmail(order.payment_method);
const itemsTotalCents = items.reduce((sum, it) => sum + it.price_cents * it.quantity, 0);
// Older orders (placed before line-item capture) may have no items; flag any
// mismatch between the recorded total and items + shipping − discount.
const mismatch =
  items.length > 0 &&
  itemsTotalCents + order.shipping_cents - order.discount_cents + order.tax_cents !==
    order.amount_total_cents;

const ship = order.ship_address
  ? (JSON.parse(order.ship_address) as {
      name: string | null;
      line1: string | null;
      line2: string | null;
      city: string | null;
      state: string | null;
      postal: string | null;
      country: string | null;
      phone?: string | null;
    })
  : null;
// Where the buyer collects a relay order, as the checkout served it.
const relayPoint = orderRelayPoint(order);
const relayPointOffer = relayPoint ? relayOffer(relayPoint.offer) : null;
// Domestic-only for now: international labels need a customs declaration this
// flow doesn't collect. Warn on the page only when the saved origin makes the
// mismatch knowable; the POST enforces it regardless. A relay parcel goes to
// its point.
const arrivalCountry = relayPoint?.country ?? ship?.country;
const labelInternational =
  !!shipFrom.country && !!arrivalCountry && shipFrom.country.toUpperCase() !== arrivalCountry.toUpperCase();
// Prefill for the recipient Boxtal requires by first and last name.
const recipient = splitName(ship?.name);
// Whether fulfillment will actually email the customer — demo orders never do,
// there may be no address on file, and email itself may be unconfigured (no
// provider key). The UI must not promise a send that would be skipped.
const willEmailCustomer =
  !!order.email &&
  order.payment_method !== 'demo' &&
  !!(await getEmailProvider(Astro.locals.settings ?? (await getStoreSettings(env.DB))));
---

<AdminLayout title={t('admin.orders.reference', { numero: num })} active="orders">
  <a
    href="/admin/orders"
    class="text-xs uppercase tracking-widest text-gray-400 hover:text-brand"
  >
    &larr; {t('admin.orders.detail.back')}
  </a>
  {/* Refund controls all live in the Refunds panel below, so the one button
      that moves money can't sit next to bookkeeping ones that don't. */}
  <div class="mt-4 mb-8">
    <h1 class="font-serif text-3xl tracking-tight">{t('admin.orders.reference', { numero: num })}</h1>
  </div>

  {
    error && (
      <p class="mb-6 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
        {error}
      </p>
    )
  }
  {
    noticeMsg && !error && (
      <p class="mb-6 rounded-md border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-700">
        {noticeMsg}
      </p>
    )
  }
  {
    inventoryExceptions.some((entry) => !entry.resolved_at) && (
      <section class="mb-8 rounded-md border border-red-300 bg-red-50 p-4 text-sm text-red-900">
        <h2 class="font-semibold">{t('admin.orders.detail.inventory.heading')}</h2>
        <p class="mt-1">{t('admin.orders.detail.inventory.intro')}</p>
        <div class="mt-4 space-y-3">
          {inventoryExceptions.filter((entry) => !entry.resolved_at).map((entry) => (
            <form method="post" action={`/api/admin/orders/${publicId}`} class="flex flex-wrap items-center justify-between gap-3 rounded border border-red-200 bg-white/60 p-3">
              <span><strong>{items.find((item) => item.product_id === entry.product_id && item.variant_id === entry.variant_id)?.name ?? t('admin.orders.detail.inventory.itemFallback')}</strong>{t('admin.orders.detail.inventory.shortfall', { demande: entry.requested_qty, disponible: entry.consumed_qty, survendu: entry.shortfall_qty })}</span>
              <input type="hidden" name="_action" value="resolve_inventory_exception" />
              <input type="hidden" name="exception_id" value={entry.public_id} />
              <button class="rounded border border-red-400 px-3 py-1.5 font-medium hover:bg-red-100">{t('admin.orders.detail.inventory.markReconciled')}</button>
            </form>
          ))}
        </div>
      </section>
    )
  }

  <dl class="mb-8 grid grid-cols-2 gap-x-8 gap-y-3 text-sm sm:max-w-lg">
    <div>
      <dt class="text-xs uppercase tracking-widest text-gray-400">{t('admin.common.status')}</dt>
      <dd class="font-medium">{statusLabel}</dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.placed')}</dt>
      <dd>{formatDate(order.created_at, undefined, timeZone)}</dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-widest text-gray-400">{t('admin.common.email')}</dt>
      <dd>{order.email ?? '—'}</dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.shipping')}</dt>
      <dd>
        {formatPrice(order.shipping_cents, order.currency)}
        {/* The snapshot taken when this order was paid. Never recomputed from the
            catalog: a later weight or rate edit must not rewrite what was charged. */}
        {order.shipping_label && <span class="text-gray-500"> · {order.shipping_label}</span>}
        {order.shipping_weight_grams != null && (
          <span class="text-gray-500">
            {' '}· {formatWeight(order.shipping_weight_grams, weightUnit)}
          </span>
        )}
      </dd>
    </div>
    {
      order.discount_cents > 0 && (
        <div>
          <dt class="text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.discount')}</dt>
          <dd>&minus;{formatPrice(order.discount_cents, order.currency)}</dd>
        </div>
      )
    }
    {
      order.tax_cents > 0 && (
        <div>
          <dt class="text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.tax')}</dt>
          <dd>{formatPrice(order.tax_cents, order.currency)}</dd>
        </div>
      )
    }
    <div>
      <dt class="text-xs uppercase tracking-widest text-gray-400">{t('admin.common.total')}</dt>
      <dd class="font-medium">{formatPrice(order.amount_total_cents, order.currency)}</dd>
    </div>
    {
      ship && (
        <div class="col-span-2">
          <dt class="text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.shipTo')}</dt>
          <dd class="whitespace-pre-line">
            {[
              ship.name,
              ship.line1,
              ship.line2,
              [ship.city, ship.state, ship.postal].filter(Boolean).join(', '),
              ship.country,
              ship.phone,
            ]
              .filter(Boolean)
              .join('\n')}
          </dd>
        </div>
      )
    }
    {
      relayPoint && (
        <div class="col-span-2">
          <dt class="text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.relayPoint')}</dt>
          <dd class="whitespace-pre-line">
            {relayPointLines(relayPoint).join('\n')}
            <span class="block text-gray-500">
              {t('admin.orders.detail.relayCode', {
                code: relayPoint.code,
                offre: relayPointOffer ? `${relayPointOffer.carrier} ${relayPointOffer.service}` : relayPoint.offer,
              })}
            </span>
          </dd>
        </div>
      )
    }
    <div>
      <dt class="text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.paymentMethod')}</dt>
      <dd>{paymentLabel}</dd>
    </div>
    <div class="col-span-2">
      <dt class="text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.paymentReference')}</dt>
      <dd class="font-mono text-xs break-all">{order.provider_session_id ?? '—'}</dd>
    </div>
  </dl>

  <RefundPanel order={order} timeZone={timeZone} />

  <div class="mb-8 rounded-lg border border-line p-5">
    <h2 class="mb-3 text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.fulfillment')}</h2>
    {
      labelUnreconciled && labelRecord && (
        <div class="mb-4 rounded-md border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900">
          <p class="mb-2 font-medium">{t('admin.orders.detail.label.unreconciled.heading')}</p>
          <p class="mb-2">
            {labelRecord.provider} {labelRecord.service}
            {labelRecord.amount_cents != null && (
              <> · {formatPrice(labelRecord.amount_cents)}{boxtalLabel && <> {t('admin.orders.detail.label.exclTax')}</>}</>
            )}
            {labelRecord.tracking_number && (
              <> · {t('admin.orders.detail.label.tracking')} <span class="tabular-nums">{labelRecord.tracking_number}</span></>
            )}
            {' '}· {t('admin.orders.detail.label.transaction')} <code class="text-xs">{labelRecord.transaction_id}</code>
          </p>
          <p class="mb-2">
            {t('admin.orders.detail.label.unreconciled.body')}
          </p>
          {labelHref && (
            <a href={labelHref} target="_blank" rel="noopener" class="font-medium underline">
              {t('admin.orders.detail.label.pdf')}
            </a>
          )}
        </div>
      )
    }
    {/* An uncertain purchase is settled by a human, keys or not, fulfilled or
        not: a charge may exist at the provider either way (ADR 0021). */}
    {
      labelUncertain && labelRecord && (
        <div class="mb-4 space-y-3 rounded-md border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900">
          <p>
            {t('admin.orders.detail.label.uncertain.lead')}
            {labelRecord.error && <> ({labelRecord.error})</>} {t('admin.orders.detail.label.uncertain.mayBefore')} <strong>{t('admin.orders.detail.label.uncertain.may')}</strong> {t('admin.orders.detail.label.uncertain.mayAfter')}.
          </p>
          {boxtalLabel ? (
            <Fragment>
              <p>{t('admin.orders.detail.label.uncertain.boxtal', { reference: labelRecord.shipment_id })}</p>
              <form method="POST" action={`/api/admin/orders/${order.public_id}`} class="flex flex-wrap items-end gap-3">
                <input type="hidden" name="_action" value="label_reconcile" />
                <label class="block">
                  <span class="block text-xs uppercase tracking-widest">{t('admin.orders.detail.label.settle.id')}</span>
                  <input
                    name="boxtal_id"
                    required
                    autocomplete="off"
                    spellcheck="false"
                    class="mt-1 rounded-md border border-amber-300 bg-white px-3 py-2 font-mono"
                  />
                </label>
                <button type="submit" class="rounded-md bg-brand px-4 py-2 text-xs font-medium uppercase tracking-wider text-white hover:bg-brand-hover">
                  {t('admin.orders.detail.label.settle.button')}
                </button>
              </form>
            </Fragment>
          ) : (
            <p>{t('admin.orders.detail.label.uncertain.shippo')}</p>
          )}
          <details class="text-xs text-amber-900/80">
            <summary class="cursor-pointer">{t('admin.orders.detail.label.override.summary')}</summary>
            <p class="mt-2">
              {t('admin.orders.detail.label.override.body')}
            </p>
            <form method="POST" action={`/api/admin/orders/${order.public_id}`} class="mt-2">
              <input type="hidden" name="_action" value="label_force_discard" />
              <button type="submit" class="rounded-md border border-amber-400 px-3 py-1.5 font-medium uppercase tracking-wider hover:bg-amber-100">
                {t('admin.orders.detail.label.override.button')}
              </button>
            </form>
          </details>
        </div>
      )
    }
    {
      fulfilled ? (
        <div class="space-y-2 text-sm">
          <p>
            <span class="font-medium text-green-700">{t('admin.orders.fulfillment.fulfilled')}</span>
            {order.fulfilled_at && <span class="text-gray-400"> · {formatDate(order.fulfilled_at, undefined, timeZone)}</span>}
          </p>
          {order.tracking_number && (
            <p>
              {carrierName(order.tracking_carrier)} ·{' '}
              {trackUrl ? (
                <a href={trackUrl} target="_blank" rel="noopener" class="text-accent hover:underline">
                  {order.tracking_number}
                </a>
              ) : (
                order.tracking_number
              )}
            </p>
          )}
          {orderLabelHref && (
            <p>
              <a href={orderLabelHref} target="_blank" rel="noopener" class="text-accent hover:underline">
                {t('admin.orders.detail.labelPdf')}
              </a>
            </p>
          )}
          <form method="POST" action={`/api/admin/orders/${order.public_id}`}>
            <input type="hidden" name="_action" value="unfulfill" />
            <button type="submit" class="text-xs uppercase tracking-widest text-gray-400 hover:text-red-600">
              {t('admin.orders.detail.markUnfulfilled')}
            </button>
          </form>
        </div>
      ) : (
        <div class="space-y-6">
          {!labelUncertain && (canLabel || labelAwaitingTracking) && (
            <div class="rounded-md border border-line bg-white/60 p-4 text-sm">
              <p class="mb-3 text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.label.buyHeading')}</p>
              {boxtalSettings?.sandbox && (
                <p class="mb-3 rounded-md border border-line bg-paper px-3 py-2 text-gray-600">
                  {t('admin.orders.detail.label.sandbox')}
                </p>
              )}
              {labelInFlight ? (
                <p class="rounded-md border border-line bg-paper px-3 py-2 text-gray-600">
                  {t('admin.orders.detail.label.inFlight')}
                </p>
              ) : labelAwaitingTracking && labelRecord ? (
                <div class="space-y-3">
                  <p>
                    {t('admin.orders.detail.label.awaiting', {
                      service: `${labelRecord.provider ?? ''} ${labelRecord.service ?? ''}`.trim(),
                      envoi: labelRecord.transaction_id ?? '—',
                    })}
                  </p>
                  <div class="flex flex-wrap items-center gap-4">
                    <form method="POST" action={`/api/admin/orders/${order.public_id}`}>
                      <input type="hidden" name="_action" value="label_tracking" />
                      <button type="submit" class="rounded-md bg-brand px-5 py-2 font-medium text-white hover:bg-brand-hover">
                        {t('admin.orders.detail.label.readTracking')}
                      </button>
                    </form>
                    {labelHref && (
                      <a href={labelHref} target="_blank" rel="noopener" class="text-accent hover:underline">
                        {t('admin.orders.detail.label.pdf')}
                      </a>
                    )}
                  </div>
                </div>
              ) : labelRecord?.status === 'purchased' ? (
                <p>
                  {t('admin.orders.detail.label.purchased', { service: `${labelRecord.provider} ${labelRecord.service}` })}{' '}
                  {labelHref && (
                    <a href={labelHref} target="_blank" rel="noopener" class="text-accent hover:underline">
                      {t('admin.orders.detail.label.pdf')}
                    </a>
                  )}
                </p>
              ) : labelInternational ? (
                <p class="text-gray-600">
                  {t('admin.orders.detail.label.international', {
                    destination: arrivalCountry ?? '—',
                    origine: shipFrom.country ?? '—',
                  })}
                </p>
              ) : quoted ? (
                <Fragment>
                  {quoted.quoteError ? (
                    <p class="mb-3 text-amber-800">{t('admin.orders.detail.label.quoteFailed', { erreur: quoted.quoteError })}</p>
                  ) : (
                    quoted.offers.every((offer) => offer.available && offer.priceExclTaxCents == null) && (
                      <p class="mb-3 text-gray-600">{t('admin.orders.detail.label.noQuote')}</p>
                    )
                  )}
                  <form method="POST" action={`/api/admin/orders/${order.public_id}`} class="space-y-4">
                    <input type="hidden" name="_action" value="buy_label" />
                    <fieldset class="space-y-2">
                      <legend class="mb-1 text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.label.offers')}</legend>
                      {quoted.offers.map((offer, i) => (
                        <label class:list={['flex items-center gap-3', !offer.available && 'text-gray-400']}>
                          <input
                            type="radio"
                            name="offer"
                            value={offer.code}
                            checked={i === 0 && offer.available}
                            disabled={!offer.available}
                            required
                            class="size-4"
                          />
                          <span class="flex-1">{offer.carrier} · {offer.service}</span>
                          <span class="tabular-nums">
                            {!offer.available
                              ? t('admin.orders.detail.label.notOffered')
                              : offer.priceExclTaxCents != null
                                ? `${formatPrice(offer.priceExclTaxCents, offer.currency ?? order.currency)} ${t('admin.orders.detail.label.exclTax')}`
                                : t('admin.orders.detail.label.unpriced')}
                          </span>
                        </label>
                      ))}
                      {relayPoint && (
                        <p class="text-xs text-gray-500">
                          {t('admin.orders.detail.label.relayPoint', { nom: relayPoint.name, code: relayPoint.code })}
                        </p>
                      )}
                    </fieldset>
                    <fieldset class="space-y-2">
                      <legend class="mb-1 text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.label.recipient')}</legend>
                      <div class="grid gap-3 sm:grid-cols-3">
                        <label class="block">
                          <span class="block text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.label.firstName')}</span>
                          <input name="to_first_name" value={recipient.firstName} required autocomplete="off" class="mt-1 w-full rounded-md border border-line bg-paper px-3 py-2" />
                        </label>
                        <label class="block">
                          <span class="block text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.label.lastName')}</span>
                          <input name="to_last_name" value={recipient.lastName} required autocomplete="off" class="mt-1 w-full rounded-md border border-line bg-paper px-3 py-2" />
                        </label>
                        <label class="block">
                          <span class="block text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.label.phone')}</span>
                          <input name="to_phone" type="tel" value={ship?.phone ?? ''} required autocomplete="off" class="mt-1 w-full rounded-md border border-line bg-paper px-3 py-2" />
                        </label>
                      </div>
                      <p class="text-xs text-gray-500">{t('admin.orders.detail.label.recipientHint')}</p>
                    </fieldset>
                    <div class="flex items-center gap-4">
                      <button
                        type="submit"
                        class="rounded-md bg-brand px-5 py-2 font-medium text-white hover:bg-brand-hover"
                      >
                        {t('admin.orders.detail.label.buy')}
                      </button>
                      <button
                        type="submit"
                        form="label-discard"
                        formnovalidate
                        class="text-xs uppercase tracking-widest text-gray-400 hover:text-brand"
                      >
                        {t('admin.orders.detail.label.startOver')}
                      </button>
                    </div>
                    <p class="text-xs text-gray-500">
                      {t('admin.orders.detail.label.buyHint')}{' '}
                      {willEmailCustomer
                        ? t('admin.orders.detail.label.willEmail')
                        : t('admin.orders.detail.label.noEmail')}
                    </p>
                  </form>
                  <form method="POST" action={`/api/admin/orders/${order.public_id}`} id="label-discard">
                    <input type="hidden" name="_action" value="label_discard" />
                  </form>
                </Fragment>
              ) : (
                <Fragment>
                  {labelRecord?.status === 'failed' && labelRecord.error && (
                    <p class="mb-3 text-red-700">{labelRecord.error}</p>
                  )}
                  <form method="POST" action={`/api/admin/orders/${order.public_id}`} class="space-y-4">
                    <input type="hidden" name="_action" value="label_rates" />
                    <fieldset class="space-y-2">
                      <legend class="mb-1 text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.label.sender')}</legend>
                      <div class="grid gap-3 sm:grid-cols-6">
                        <label class="block sm:col-span-6">
                          <span class="block text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.label.company')}</span>
                          <input name="from_company" value={shipFrom.company ?? ''} required class="mt-1 w-full rounded-md border border-line bg-paper px-3 py-2" />
                        </label>
                        <label class="block sm:col-span-3">
                          <span class="block text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.label.firstName')}</span>
                          <input name="from_first_name" value={shipFrom.firstName ?? ''} required class="mt-1 w-full rounded-md border border-line bg-paper px-3 py-2" />
                        </label>
                        <label class="block sm:col-span-3">
                          <span class="block text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.label.lastName')}</span>
                          <input name="from_last_name" value={shipFrom.lastName ?? ''} required class="mt-1 w-full rounded-md border border-line bg-paper px-3 py-2" />
                        </label>
                        <label class="block sm:col-span-3">
                          <span class="block text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.label.email')}</span>
                          <input name="from_email" type="email" value={shipFrom.email ?? ''} required class="mt-1 w-full rounded-md border border-line bg-paper px-3 py-2" />
                        </label>
                        <label class="block sm:col-span-3">
                          <span class="block text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.label.phone')}</span>
                          <input name="from_phone" type="tel" value={shipFrom.phone ?? ''} required class="mt-1 w-full rounded-md border border-line bg-paper px-3 py-2" />
                        </label>
                        <label class="block sm:col-span-6">
                          <span class="block text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.label.street')}</span>
                          <input name="from_street" value={shipFrom.street ?? ''} required class="mt-1 w-full rounded-md border border-line bg-paper px-3 py-2" />
                        </label>
                        <label class="block sm:col-span-2">
                          <span class="block text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.label.postal')}</span>
                          <input name="from_postal" value={shipFrom.postalCode ?? ''} required class="mt-1 w-full rounded-md border border-line bg-paper px-3 py-2" />
                        </label>
                        <label class="block sm:col-span-3">
                          <span class="block text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.label.city')}</span>
                          <input name="from_city" value={shipFrom.city ?? ''} required class="mt-1 w-full rounded-md border border-line bg-paper px-3 py-2" />
                        </label>
                        <label class="block sm:col-span-1">
                          <span class="block text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.label.country')}</span>
                          <input name="from_country" value={shipFrom.country ?? 'FR'} required maxlength="2" class="mt-1 w-full rounded-md border border-line bg-paper px-3 py-2 uppercase" />
                        </label>
                      </div>
                    </fieldset>
                    <fieldset class="space-y-2">
                      <legend class="mb-1 text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.label.parcel')}</legend>
                      <div class="grid gap-3 sm:grid-cols-4">
                        <label class="block">
                          <span class="block text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.label.length', { unite: 'cm' })}</span>
                          <input name="parcel_length" value={parcelDefault.length ?? ''} required inputmode="decimal" class="mt-1 w-full rounded-md border border-line bg-paper px-3 py-2" />
                        </label>
                        <label class="block">
                          <span class="block text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.label.width', { unite: 'cm' })}</span>
                          <input name="parcel_width" value={parcelDefault.width ?? ''} required inputmode="decimal" class="mt-1 w-full rounded-md border border-line bg-paper px-3 py-2" />
                        </label>
                        <label class="block">
                          <span class="block text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.label.height', { unite: 'cm' })}</span>
                          <input name="parcel_height" value={parcelDefault.height ?? ''} required inputmode="decimal" class="mt-1 w-full rounded-md border border-line bg-paper px-3 py-2" />
                        </label>
                        <label class="block">
                          <span class="block text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.label.weight', { unite: weightUnit })}</span>
                          <input name="parcel_weight" value={parcelWeightValue} required inputmode="decimal" class="mt-1 w-full rounded-md border border-line bg-paper px-3 py-2" />
                        </label>
                      </div>
                    </fieldset>
                    <button
                      type="submit"
                      class="rounded-md bg-brand px-5 py-2 font-medium text-white hover:bg-brand-hover"
                    >
                      {t('admin.orders.detail.label.getRates')}
                    </button>
                    <p class="text-xs text-gray-500">
                      {t('admin.orders.detail.label.ratesHint')}
                    </p>
                  </form>
                </Fragment>
              )}
            </div>
          )}
          {!canLabel && boxtal && !labelSettingsReady && labelEligible && (
            <p class="text-xs text-gray-500">
              <a href="/admin/settings#boxtal" class="text-accent hover:underline">{t('admin.orders.detail.label.settingsMissing')}</a>
            </p>
          )}
        <form
          method="POST"
          action={`/api/admin/orders/${order.public_id}`}
          class="flex flex-wrap items-end gap-3 text-sm"
        >
          <input type="hidden" name="_action" value="fulfill" />
          <label class="block">
            <span class="block text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.carrier')}</span>
            <select name="carrier" class="mt-1 rounded-md border border-line bg-paper px-3 py-2">
              {CARRIERS.map((c) => (
                <option value={c.code}>{c.name}</option>
              ))}
            </select>
          </label>
          <label class="block">
            <span class="block text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.trackingNumber')}</span>
            <input
              name="tracking_number"
              type="text"
              class="mt-1 rounded-md border border-line bg-paper px-3 py-2"
            />
          </label>
          <button
            type="submit"
            class="rounded-md bg-brand px-5 py-2 font-medium text-white hover:bg-brand-hover"
          >
            {t('admin.orders.detail.markFulfilled')}
          </button>
        </form>
        </div>
      )
    }
    {
      labelAttempts.length > 0 && (
        <details class="mt-5 border-t border-line pt-4">
          <summary class="cursor-pointer text-xs uppercase tracking-widest text-gray-500">
            {t('admin.orders.detail.labelHistory.heading', { nombre: labelAttempts.length })}
          </summary>
          <ol class="mt-3 space-y-3">
            {labelAttempts.map((attempt) => (
              <li class="rounded-md bg-paper px-3 py-2 text-xs text-gray-600">
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <span class="font-medium text-gray-800">
                    {outcomeLabel(attempt.outcome)}
                  </span>
                  <time datetime={`${attempt.settled_at.replace(' ', 'T')}Z`}>
                    {formatDate(attempt.settled_at, undefined, timeZone)}
                  </time>
                </div>
                {(attempt.provider || attempt.service || attempt.amount_cents != null) && (
                  <p class="mt-1">
                    {[attempt.provider, attempt.service].filter(Boolean).join(' ')}
                    {attempt.amount_cents != null && <> · {formatPrice(attempt.amount_cents)}</>}
                  </p>
                )}
                {attempt.tracking_number && (
                  <p class="mt-1">
                    {t('admin.orders.detail.labelHistory.tracking', { numero: attempt.tracking_number })}
                  </p>
                )}
                {attempt.transaction_id && (
                  <p class="mt-1">
                    {t('admin.orders.detail.labelHistory.transaction')} <code>{attempt.transaction_id}</code>
                  </p>
                )}
                {attempt.error && <p class="mt-1">{attempt.error}</p>}
                {attempt.label_url && (
                  <p class="mt-1">
                    <a
                      href={attempt.label_url}
                      target="_blank"
                      rel="noopener"
                      class="text-accent hover:underline"
                    >
                      {t('admin.orders.detail.label.pdf')}
                    </a>
                  </p>
                )}
              </li>
            ))}
          </ol>
        </details>
      )
    }
  </div>

  {
    canReissue && (
      <div class="mb-8 rounded-lg border border-line p-5">
        <h2 class="mb-3 text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.customerLink.heading')}</h2>
        {/* Support remedy for a forwarded or leaked guest link: rotates the
            stored access token and emails the customer the replacement. The
            token is never shown here — the email is the only delivery path. */}
        <form
          method="POST"
          action={`/api/admin/orders/${order.public_id}`}
          onsubmit={`return confirm(${JSON.stringify(t('admin.orders.detail.customerLink.confirm', { email: order.email ?? '' }))})`}
        >
          <input type="hidden" name="_action" value="reissue_link" />
          <button
            type="submit"
            class="rounded-md border border-line px-4 py-2 text-xs font-medium uppercase tracking-wider text-gray-700 hover:border-brand hover:text-brand"
          >
            {t('admin.orders.detail.customerLink.button')}
          </button>
          <p class="mt-2 text-xs text-gray-500">
            {t('admin.orders.detail.customerLink.hint')}
          </p>
        </form>
      </div>
    )
  }

  <h2 class="mb-3 text-xs uppercase tracking-widest text-gray-400">{t('admin.orders.detail.items')}</h2>
  <div class="sm:overflow-x-auto">
    <table class="admin-table w-full text-left text-sm sm:min-w-[34rem]">
    <thead>
      <tr class="border-b border-line text-xs uppercase tracking-widest text-gray-400">
        <th class="py-3 pr-4 font-normal">{t('admin.orders.detail.items.product')}</th>
        <th class="py-3 pr-4 font-normal">{t('admin.orders.detail.items.unitPrice')}</th>
        <th class="py-3 pr-4 font-normal">{t('admin.orders.detail.items.quantity')}</th>
        <th class="py-3 text-right font-normal">{t('admin.orders.detail.items.lineTotal')}</th>
      </tr>
    </thead>
    <tbody>
      {
        items.map((it) => (
          <tr class="border-b border-line">
            <td class="py-3 pr-4">
              {it.product_public_id ? (
                <a href={`/admin/products/${it.product_public_id}/edit`} class="text-accent hover:underline">
                  {it.name}
                </a>
              ) : (
                it.name
              )}
            </td>
            <td data-label={t('admin.orders.detail.items.unitPrice')} class="py-3 pr-4 tabular-nums">{formatPrice(it.price_cents, order.currency)}</td>
            <td data-label={t('admin.orders.detail.items.quantity')} class="py-3 pr-4 tabular-nums">{it.quantity}</td>
            <td data-label={t('admin.orders.detail.items.lineTotal')} class="py-3 text-right tabular-nums">
              {formatPrice(it.price_cents * it.quantity, order.currency)}
            </td>
          </tr>
        ))
      }
      {
        items.length === 0 && (
          <tr>
            <td colspan="4" class="py-8 text-center text-gray-400">
              {t('admin.orders.detail.items.empty')}
            </td>
          </tr>
        )
      }
    </tbody>
    </table>
  </div>

  {
    mismatch && (
      <p class="mt-3 text-sm text-amber-700">
        {t('admin.orders.detail.mismatch', { montant: formatPrice(itemsTotalCents, order.currency) })}
      </p>
    )
  }
</AdminLayout>
