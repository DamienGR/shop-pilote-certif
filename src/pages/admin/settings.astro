    <form method="POST" class="mb-4 rounded-lg border border-gray-200 bg-white p-4">
      <input type="hidden" name="_action" value="save_home" />
      <p class="mb-3 text-xs uppercase tracking-widest text-gray-400">{t('admin.settings.home.heading')}</p>
      <div class="flex flex-wrap items-end gap-3">
        <label class="flex flex-col gap-1 text-xs uppercase tracking-widest text-gray-400">
          <span class="sr-only">{t('admin.settings.home.selectLabel')}</span>
          <select
            name="home_page"
            class="w-80 rounded-md border border-gray-300 px-3 py-2 text-sm normal-case tracking-normal text-gray-900 focus:border-brand focus:outline-none"
          >
            <option value="" selected={homeChoice === ''}>{t('admin.settings.home.default')}</option>
            {
              homePages.length > 0 && (
                <optgroup label={t('admin.settings.home.groupPage')}>
                  {homePages.map((p) => (
                    <option value={`page:${p.public_id}`} selected={homeChoice === `page:${p.id}`}>
                      {p.title}
                    </option>
                  ))}
                </optgroup>
              )
            }
            {
              homeProducts.length > 0 && (
                <optgroup label={t('admin.settings.home.groupProduct')}>
                  {homeProducts.map((p) => (
                    <option value={`product:${p.public_id}`} selected={homeChoice === `product:${p.id}`}>
                      {p.name}
                    </option>
                  ))}
                </optgroup>
              )
            }
          </select>
        </label>
      </div>
      {
        homeChoiceMissing && (
          <p class="mt-3 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800">
            {t('admin.settings.home.missing')}
          </p>
        )
      }
      {
        catalogOrphaned && (
          <p class="mt-3 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800">
            {t('admin.settings.home.orphaned.before')} <code>/products</code>{' '}
            {t('admin.settings.home.orphaned.middle')}{' '}
            <a href="/admin/navigation" class="underline hover:text-brand">{t('admin.settings.home.orphaned.link')}</a>.
          </p>
        )
      }
      <p class="mt-3 text-xs text-gray-400">
        {t('admin.settings.home.hint')} {t('admin.settings.purgeNote')}
      </p>
      <button
        type="submit"
        class="mt-4 rounded-md bg-brand px-4 py-2 text-xs font-medium uppercase tracking-wider text-white hover:bg-brand-hover"
      >
        {t('admin.common.save')}
      </button>
    </form>

    <form method="POST" class="mb-4 rounded-lg border border-gray-200 bg-white p-4">
      <input type="hidden" name="_action" value="save_announcement" />
      <div class="flex flex-wrap items-end gap-3">
        <label class="flex flex-col gap-1 text-xs uppercase tracking-widest text-gray-400">
          {t('admin.settings.announcement.label')}
          <input
            type="text"
            name="announcement"
            value={announcement}
            maxlength="200"
            placeholder={t('admin.settings.announcement.placeholder')}
            class="w-80 max-w-full rounded-md border border-gray-300 px-3 py-2 text-sm normal-case tracking-normal text-gray-900 focus:border-brand focus:outline-none"
          />
        </label>
        <label class="flex flex-col gap-1 text-xs uppercase tracking-widest text-gray-400">
          {t('admin.settings.announcement.link')}
          <input
            type="text"
            name="announcement_href"
            value={announcementHref}
            placeholder={t('admin.settings.announcement.linkPlaceholder')}
            class="w-56 max-w-full rounded-md border border-gray-300 px-3 py-2 text-sm normal-case tracking-normal text-gray-900 focus:border-brand focus:outline-none"
          />
        </label>
      </div>
      <p class="mt-3 text-xs text-gray-400">
        {t('admin.settings.announcement.hint')}
      </p>
      <button
        type="submit"
        class="mt-4 rounded-md bg-brand px-4 py-2 text-xs font-medium uppercase tracking-wider text-white hover:bg-brand-hover"
      >
        {t('admin.common.save')}
      </button>
    </form>

    {/* Shipping used to be a toggle here while the zones lived in store.config.ts —
        two controls that could disagree. Zones and rates now have their own page;
        only the weight unit lives here, deliberately in a DIFFERENT form from the
        rate editor so changing it can never reinterpret values typed on that page
        (forms always re-render converted from grams). */}
    <div class="mb-4 rounded-lg border border-gray-200 bg-white px-4 py-4">
      <a href="/admin/shipping" class="group block">
        <p class="font-medium group-hover:text-brand">{t('admin.settings.shipping.title')}</p>
        <p class="text-xs text-gray-500">
          {effectiveShipping.enabled ? t('admin.settings.shipping.on') : t('admin.settings.shipping.off')} ·{' '}
          {tn('admin.settings.shipping.zones.one', 'admin.settings.shipping.zones.other', effectiveShipping.zones.length)} ·{' '}
          {t('admin.settings.shipping.summary')} <span aria-hidden="true" class="text-brand">&rarr;</span>
        </p>
      </a>
      <form method="POST" class="mt-4 border-t border-gray-100 pt-4">
        <input type="hidden" name="_action" value="save_weight_unit" />
        <div class="flex flex-wrap items-end gap-3">
          <label class="flex flex-col gap-1 text-xs uppercase tracking-widest text-gray-400">
            {t('admin.settings.weightUnit.label')}
            <select
              name="weight_unit"
              class="w-24 rounded-md border border-gray-300 px-3 py-2 text-sm normal-case tracking-normal text-gray-900 focus:border-brand focus:outline-none"
            >
              {WEIGHT_UNITS.map((u) => (
                <option value={u} selected={u === weightUnit}>
                  {u}
                </option>
              ))}
            </select>
          </label>
        </div>
        <p class="mt-3 text-xs text-gray-400">
          {t('admin.settings.weightUnit.hint')}
        </p>
        <button
          type="submit"
          class="mt-4 rounded-md bg-brand px-4 py-2 text-xs font-medium uppercase tracking-wider text-white hover:bg-brand-hover"
        >
          {t('admin.common.save')}
        </button>
      </form>
    </div>

    {/* Shipping labels are optional infrastructure like the payment rails: the
        card is one token field, and nothing label-related renders anywhere else
        until the token exists. */}
    <div class="mb-4 rounded-lg border border-gray-200 bg-white px-4 py-4">
      <p class="font-medium">{t('admin.settings.shippo.title')}</p>
      <p class="mt-1 text-xs text-gray-500">
        {t('admin.settings.shippo.intro')}
        <code class="text-[11px]">shippo_test_…</code> {t('admin.settings.shippo.introAfter')}
      </p>
      <form method="POST" class="mt-3 space-y-3">
        <input type="hidden" name="_action" value="save_shippo" />
        <SecretField name="shippo_api_key" label={t('admin.settings.shippo.token')} hint={t('admin.settings.shippo.tokenHint')} storedInD1={inD1('shippo_api_key')} vault={vault} />
        {vault && (
          <button type="submit" class="mt-1 rounded-md bg-brand px-4 py-2 text-xs font-medium uppercase tracking-wider text-white hover:bg-brand-hover">
            {t('admin.common.save')}
          </button>
        )}
      </form>
    </div>

    <ul class="mb-10 divide-y divide-gray-100 overflow-hidden rounded-lg border border-gray-200 bg-white">
      {
        featureRows.map((f) => (
          <li class="flex items-center justify-between gap-4 px-4 py-4">
            <div class="min-w-0">
              <p class="font-medium">{f.label}</p>
              <p class={f.available ? 'text-xs text-gray-500' : 'text-xs text-amber-700'}>
                {f.available ? f.desc : f.reason}
              </p>
            </div>
            {
              f.available || f.on ? (
                <form method="POST" class="shrink-0">
                  <input type="hidden" name="_action" value="toggle_feature" />
                  <input type="hidden" name="feature" value={f.key} />
                  <input type="hidden" name="enabled" value={f.on ? '0' : '1'} />
                  <button
                    type="submit"
                    role="switch"
                    aria-checked={f.on ? 'true' : 'false'}
                    aria-label={t(f.on ? 'admin.settings.toggle.disable' : 'admin.settings.toggle.enable', { nom: f.label })}
                    class={`relative inline-flex h-6 w-11 items-center rounded-full transition ${
                      f.on ? 'bg-brand' : 'bg-gray-300'
                    }`}
                  >
                    <span
                      class={`inline-block size-5 rounded-full bg-white shadow transition ${
                        f.on ? 'translate-x-5' : 'translate-x-0.5'
                      }`}
                    />
                  </button>
                </form>
              ) : (
                <span class="shrink-0 text-xs uppercase tracking-widest text-gray-400">
                  {t('admin.settings.unavailable')}
                </span>
              )
            }
          </li>
        ))
      }
    </ul>
  </section>

  {/* ── Images (runtime delivery selector) ───────────────────────────────── */}
  <section id="images" class="mt-10 scroll-mt-16">
    <h2 class="mb-2 text-lg font-bold">{t('admin.settings.section.images')}</h2>
    <p class="mb-4 text-sm text-gray-500">
      {t('admin.settings.images.intro')}
    </p>

    <form method="POST" class="mb-10 rounded-lg border border-gray-200 bg-white p-4">
      <input type="hidden" name="_action" value="set_image_delivery" />
      <fieldset class="space-y-3">
        <legend class="sr-only">{t('admin.settings.images.legend')}</legend>
        <label class="flex cursor-pointer items-start gap-3 rounded-md border border-line p-3">
          <input
            type="radio"
            name="image_delivery"
            value="original"
            checked={settings.imageDelivery === 'original'}
            class="mt-1 accent-brand"
          />
          <span>
            <span class="block font-medium">{t('admin.settings.images.original.title')}</span>
            <span class="block text-xs text-gray-500">
              {t('admin.settings.images.original.desc')}
            </span>
          </span>
        </label>

        <label
          class:list={[
            'flex items-start gap-3 rounded-md border border-line p-3',
            onDemandImagesReady ? 'cursor-pointer' : 'cursor-not-allowed opacity-60',
          ]}
        >
          <input
            type="radio"
            name="image_delivery"
            value="cloudflare"
            checked={settings.imageDelivery === 'cloudflare'}
            disabled={!onDemandImagesReady}
            class="mt-1 accent-brand"
          />
          <span>
            <span class="block font-medium">
              {t('admin.settings.images.cloudflare.title')}
              {!onDemandImagesReady && (
                <span class="ml-2 text-xs uppercase tracking-widest text-amber-700">
                  {t('admin.settings.unavailable')}
                </span>
              )}
            </span>
            <span class={onDemandImagesReady ? 'block text-xs text-gray-500' : 'block text-xs text-amber-700'}>
              {onDemandImagesReady
                ? t('admin.settings.images.cloudflare.desc')
                : t('admin.settings.images.cloudflare.setup')}
            </span>
            {onDemandImagesReady && (
              <span class="mt-1 block text-xs text-amber-700">
                {t('admin.settings.images.cloudflare.quota')}
              </span>
            )}
          </span>
        </label>
      </fieldset>

      <div class="mt-4 flex flex-wrap items-center gap-3">
        <button
          type="submit"
          class="rounded-md bg-brand px-4 py-2 text-xs font-medium uppercase tracking-wider text-white hover:bg-brand-hover"
        >
          {t('admin.settings.images.save')}
        </button>
        <p class="text-xs text-gray-400">
          {t('admin.settings.purgeNote')}
        </p>
      </div>
      <p class="mt-3 text-xs text-gray-400">
        {t('admin.settings.images.note.before')}
        <strong class="font-medium text-gray-500">{t('admin.settings.feature.imageOptimize.label')}</strong>
        {t('admin.settings.images.note.after')}
      </p>
    </form>
  </section>

  {/* ── Payments (keys + config grouped per method) ──────────────────────── */}
  <section id="payments" class="mt-10 scroll-mt-16">
    <h2 class="mb-2 text-lg font-bold">{t('admin.settings.section.payments')}</h2>
    <p class="mb-4 text-sm text-gray-500">
      {t('admin.settings.payments.intro')}
    </p>

    {
      !vault && (
        <p class="mb-4 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800">
          {t('admin.settings.payments.noVault.before')} <code>SECRETS_KEK</code>{' '}
          {t('admin.settings.payments.noVault.middle')}{' '}
          <code>openssl rand -base64 32 | wrangler secret put SECRETS_KEK</code>{' '}
          {t('admin.settings.payments.noVault.after')}
        </p>
      )
    }

    {/* Store-wide default rail */}
    <form method="POST" class="mb-6 rounded-lg border border-gray-200 bg-white p-4">
      <input type="hidden" name="_action" value="save_default" />
      <label class="flex flex-col gap-1 text-xs uppercase tracking-widest text-gray-400">
        {t('admin.settings.payments.default.label')}
        <select
          name="payment_provider"
          class="w-48 rounded-md border border-gray-300 px-3 py-2 text-sm normal-case tracking-normal text-gray-900 focus:border-brand focus:outline-none"
        >
          {
            pmRows.map((row) => (
              <option
                value={row.m}
                selected={payments.provider === row.m}
                disabled={!row.enabled}
              >
                {row.enabled ? row.label : t('admin.settings.payments.default.optionUnavailable', { nom: row.label })}
              </option>
            ))
          }
        </select>
      </label>
      <p class="mt-3 text-xs text-gray-400">
        {t('admin.settings.payments.default.hint')}
      </p>
      <button
        type="submit"
        disabled={!pmRows.some((row) => row.enabled)}
        class="mt-4 rounded-md bg-brand px-4 py-2 text-xs font-medium uppercase tracking-wider text-white hover:bg-brand-hover disabled:cursor-not-allowed disabled:bg-gray-300"
      >
        {t('admin.common.save')}
      </button>
    </form>

    <div class="space-y-4">
      {/* Card (Stripe) */}
      <div class="rounded-lg border border-gray-200 bg-white p-4">
        <div class="mb-3 flex items-center justify-between gap-3">
          <div>
            <p class="font-medium">{t('admin.settings.payments.method.stripe')}</p>
            <p class={pmMap.stripe.installed ? 'text-xs text-gray-500' : 'text-xs text-amber-700'}>
              {pmMap.stripe.installed ? t('admin.settings.payments.live') : t('admin.settings.payments.stripe.notLive')}
            </p>
          </div>
          {pmMap.stripe.installed && <MethodToggle method="stripe" enabled={pmMap.stripe.enabled} label={t('admin.settings.payments.method.stripe')} />}
        </div>
        <form method="POST" class="space-y-3 border-t border-gray-100 pt-3">
          <input type="hidden" name="_action" value="save_stripe" />
          <SecretField name="stripe_secret_key" label={t('admin.settings.payments.stripe.secretKey')} hint={t('admin.settings.payments.stripe.secretKeyHint')} storedInD1={inD1('stripe_secret_key')} vault={vault} />
          <SecretField name="stripe_webhook_secret" label={t('admin.settings.payments.stripe.webhookSecret')} hint="whsec_…" storedInD1={inD1('stripe_webhook_secret')} vault={vault} />
          {vault && (
            <button type="submit" class="mt-1 rounded-md bg-brand px-4 py-2 text-xs font-medium uppercase tracking-wider text-white hover:bg-brand-hover">
              {t('admin.common.save')}
            </button>
          )}
        </form>
      </div>

      {/* Lightning */}
      <div class="rounded-lg border border-gray-200 bg-white p-4">
        <div class="mb-3 flex items-center justify-between gap-3">
          <div>
            <p class="font-medium">{t('admin.settings.payments.method.lightning')}</p>
            <p class={pmMap.lightning.installed ? 'text-xs text-gray-500' : 'text-xs text-amber-700'}>
              {pmMap.lightning.installed ? t('admin.settings.payments.live') : t('admin.settings.payments.lightning.notLive')}
            </p>
          </div>
          {pmMap.lightning.installed && <MethodToggle method="lightning" enabled={pmMap.lightning.enabled} label={t('admin.settings.payments.method.lightning')} />}
        </div>
        <form method="POST" class="space-y-3 border-t border-gray-100 pt-3">
          <input type="hidden" name="_action" value="save_lightning" />
          <label class="flex w-fit flex-col gap-1 text-xs uppercase tracking-widest text-gray-400">
            {t('admin.settings.payments.lightning.backend')}
            <select name="lightning_backend" data-lightning-backend class="w-40 rounded-md border border-gray-300 px-3 py-2 text-sm normal-case tracking-normal text-gray-900 focus:border-brand focus:outline-none">
              <option value="phoenixd" selected={payments.lightningBackend === 'phoenixd'}>phoenixd</option>
              <option value="lnbits" selected={payments.lightningBackend === 'lnbits'}>LNbits</option>
            </select>
          </label>

          <div
            data-lightning-when="lnbits"
            hidden={payments.lightningBackend !== 'lnbits'}
            class="space-y-3 rounded-md border border-gray-100 bg-gray-50 p-3"
          >
            <label class="flex flex-col gap-1 text-xs uppercase tracking-widest text-gray-400">
              {t('admin.settings.payments.lightning.lnbitsUrl')}
              <input type="url" name="lnbits_url" value={payments.lnbitsUrl} required={payments.lightningBackend === 'lnbits'} data-lightning-required-when="lnbits" placeholder="https://lnbits.example.com" class="w-64 max-w-full rounded-md border border-gray-300 px-3 py-2 text-sm normal-case tracking-normal text-gray-900 focus:border-brand focus:outline-none" />
            </label>
            <SecretField name="lnbits_api_key" label={t('admin.settings.payments.lightning.lnbitsKey')} hint={t('admin.settings.payments.lightning.lnbitsKeyHint')} storedInD1={inD1('lnbits_api_key')} vault={vault} required={payments.lightningBackend === 'lnbits'} requiredWhen="lnbits" />
          </div>

          <div
            data-lightning-when="phoenixd"
            hidden={payments.lightningBackend !== 'phoenixd'}
            class="space-y-3 rounded-md border border-gray-100 bg-gray-50 p-3"
          >
            <label class="flex flex-col gap-1 text-xs uppercase tracking-widest text-gray-400">
              {t('admin.settings.payments.lightning.phoenixdUrl')}
              <input type="url" name="phoenixd_url" value={payments.phoenixdUrl} required={payments.lightningBackend === 'phoenixd'} data-lightning-required-when="phoenixd" placeholder="https://ln.example.com" class="w-64 max-w-full rounded-md border border-gray-300 px-3 py-2 text-sm normal-case tracking-normal text-gray-900 focus:border-brand focus:outline-none" />
            </label>
            <SecretField name="phoenixd_password" label={t('admin.settings.payments.lightning.phoenixdPassword')} hint="http-password-limited-access" storedInD1={inD1('phoenixd_password')} vault={vault} required={payments.lightningBackend === 'phoenixd'} requiredWhen="phoenixd" />
          </div>
          {vault && (
            <button type="submit" class="mt-1 rounded-md bg-brand px-4 py-2 text-xs font-medium uppercase tracking-wider text-white hover:bg-brand-hover">
              {t('admin.common.save')}
            </button>
          )}
        </form>
      </div>

      {/* Bitcoin (OpenNode) */}
      <div class="rounded-lg border border-gray-200 bg-white p-4">
        <div class="mb-3 flex items-center justify-between gap-3">
          <div>
            <p class="font-medium">{t('admin.settings.payments.method.opennode')}</p>
            <p class={pmMap.opennode.installed ? 'text-xs text-gray-500' : 'text-xs text-amber-700'}>
              {pmMap.opennode.installed ? t('admin.settings.payments.live') : t('admin.settings.payments.opennode.notLive')}
            </p>
          </div>
          {pmMap.opennode.installed && <MethodToggle method="opennode" enabled={pmMap.opennode.enabled} label={t('admin.settings.payments.method.opennode')} />}
        </div>
        <form method="POST" class="space-y-3 border-t border-gray-100 pt-3">
          <input type="hidden" name="_action" value="save_opennode" />
