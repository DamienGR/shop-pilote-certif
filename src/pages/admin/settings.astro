  <script
    is:inline
    define:vars={{
      reindexText: {
        running: t('admin.settings.search.reindexRunning'),
        starting: t('admin.settings.search.reindexStarting'),
        count: t('admin.settings.search.reindexCount'),
        doneOne: t('admin.settings.search.reindexDone.one'),
        doneOther: t('admin.settings.search.reindexDone.other'),
        failed: t('admin.settings.search.reindexFailed'),
        all: t('admin.settings.search.reindexAll'),
        resume: t('admin.settings.search.reindexContinue'),
      },
    }}
  >
    // Reindex in bounded Worker requests. The server also carries the cursor
    // through redirects, so without JS the same form becomes a Continue button.
    // Strings come in through define:vars (reindexText), never an import.
    (function () {
      if (!window.fetch) return;
      var form = document.querySelector('[data-reindex-form]');
      if (!form) return;
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var button = form.querySelector('button[type="submit"]');
        var label = form.querySelector('[data-reindex-label]');
        var status = document.querySelector('[data-reindex-status]');
        var cursor = form.querySelector('input[name="cursor"]');
        var processed = form.querySelector('input[name="processed"]');
        if (button) button.disabled = true;
        if (label) label.textContent = reindexText.running;
        if (status) status.textContent = reindexText.starting;

        function nextBatch() {
          return fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: {
              Accept: 'application/json',
              'X-Requested-With': 'fetch',
            },
          })
            .then(function (response) {
              return response.json().then(function (data) {
                if (!response.ok) throw new Error(data.error || reindexText.failed);
                return data;
              });
            })
            .then(function (data) {
              if (status)
                status.textContent = reindexText.count
                  .replace('{traites}', data.processed)
                  .replace('{total}', data.total);
              if (data.done) {
                if (cursor) cursor.value = '';
                if (processed) processed.value = '0';
                if (button) button.disabled = false;
                if (label) label.textContent = reindexText.all;
                if (status) {
                  // French plural: 0 and 1 take the singular, as tn() does.
                  status.textContent = (Math.abs(data.processed) < 2
                    ? reindexText.doneOne
                    : reindexText.doneOther
                  ).replace('{count}', data.processed);
                  status.className = 'text-xs font-medium text-green-600';
                }
                return;
              }
              if (cursor) cursor.value = data.nextCursor || '';
              if (processed) processed.value = String(data.processed || 0);
              return nextBatch();
            });
        }

        nextBatch().catch(function (error) {
          if (button) button.disabled = false;
          if (label) label.textContent = reindexText.resume;
          if (status) {
            status.textContent = error && error.message ? error.message : reindexText.failed;
            status.className = 'text-xs font-medium text-red-600';
          }
        });
      });
    })();
  </script>

  <script is:inline>
    // The selected Lightning backend owns the required URL + credential pair.
    // Delegated events survive the settings section's inline-save replacement.
    (function () {
      function syncLightning(sel) {
        var section = sel.closest('section');
        if (!section) return;
        var blocks = section.querySelectorAll('[data-lightning-when]');
        Array.prototype.forEach.call(blocks, function (block) {
          block.hidden = block.getAttribute('data-lightning-when') !== sel.value;
        });
        var fields = section.querySelectorAll('[data-lightning-required-when]');
        Array.prototype.forEach.call(fields, function (field) {
          var active = field.getAttribute('data-lightning-required-when') === sel.value;
          var stored = field.getAttribute('data-secret-stored') === '1';
          field.required = active && !stored;
        });
      }
      document.addEventListener('change', function (e) {
        var target = e.target;
        if (target && target.matches && target.matches('[data-lightning-backend]')) {
          syncLightning(target);
        }
      });
    })();
  </script>

  <script
    is:inline
    define:vars={{
      savedText: t('admin.settings.inlineSave.saved'),
      saveFailedText: t('admin.settings.inlineSave.failed'),
    }}
  >
    // Inline saves (progressive enhancement). Without JS each section form POSTs
    // normally (303 + flash). With JS we submit in the background, then re-fetch the
    // page and swap just this section's freshly-rendered markup — so chips, inputs,
    // and toggles update without a full reload or losing your scroll position.
    (function () {
      if (!window.fetch || !window.DOMParser) return;
      var path = location.pathname;

      function toast(scope, text, isErr) {
        var prev = scope.querySelector('[data-toast]');
        if (prev) prev.remove();
        var n = document.createElement('span');
        n.setAttribute('data-toast', '');
        n.textContent = text;
        n.className = 'ml-3 text-xs font-medium ' + (isErr ? 'text-red-600' : 'text-green-600');
        var btn = scope.querySelector('button[type="submit"]');
        if (btn && btn.parentNode) btn.parentNode.insertBefore(n, btn.nextSibling);
        else scope.appendChild(n);
        setTimeout(function () {
          n.style.transition = 'opacity .5s';
          n.style.opacity = '0';
          setTimeout(function () { n.remove(); }, 500);
        }, 2200);
      }

      function bind(scope) {
        // Bind every section's same-page POST form. Querying without a descendant
        // combinator so it works whether `scope` is the document OR a single swapped
        // section node. form.method is lowercased by the DOM regardless of attr case;
        // skip GET forms and ones that post elsewhere (e.g. the reindex API).
        var forms = scope.querySelectorAll('form:not([action]):not([data-ajax])');
        Array.prototype.forEach.call(forms, function (form) {
          if (form.method !== 'post' || !form.closest('section[id]')) return;
          form.setAttribute('data-ajax', '');
          form.addEventListener('submit', function (e) {
            e.preventDefault();
            var section = form.closest('section[id]');
            if (!section) return;
            var isToggle = !!form.querySelector('[role="switch"]');
            var btn = form.querySelector('button[type="submit"]');
            if (btn) btn.disabled = true;
            fetch(path, {
              method: 'POST',
              body: new FormData(form),
              headers: { 'X-Requested-With': 'fetch' },
            })
              .then(function (r) {
                if (!r.ok) throw new Error('save');
                return fetch(path, { headers: { 'X-Requested-With': 'fetch' } });
              })
              .then(function (r) { return r.text(); })
              .then(function (html) {
                var fresh = new DOMParser()
                  .parseFromString(html, 'text/html')
                  .getElementById(section.id);
                if (!fresh) { location.reload(); return; }
                section.replaceWith(fresh);
                bind(fresh);
                if (!isToggle) toast(fresh, savedText, false);
              })
              .catch(function () {
                if (btn) btn.disabled = false;
                toast(form, saveFailedText, true);
              });
          });
        });
      }
      bind(document);
    })();
  </script>

  <script
    is:inline
    define:vars={{
      emailTestText: {
        sending: t('admin.settings.email.test.sending'),
        sent: t('admin.settings.email.test.sent'),
        failed: t('admin.settings.email.test.failed'),
        requestFailed: t('admin.settings.email.test.requestFailed'),
      },
    }}
  >
    // Email section: live-toggle the provider-specific block (Resend key vs the
    // Cloudflare note) as the dropdown changes, and send a test email inline.
    // Delegated from document so it survives the inline-save section swap.
    (function () {
      function syncProvider(sel) {
        var section = sel.closest('section');
        if (!section) return;
        var blocks = section.querySelectorAll('[data-email-when]');
        Array.prototype.forEach.call(blocks, function (el) {
          el.hidden = el.getAttribute('data-email-when') !== sel.value;
        });
      }
      document.addEventListener('change', function (e) {
        var t = e.target;
        if (t && t.matches && t.matches('[data-email-provider]')) syncProvider(t);
      });

      if (!window.fetch) return;
      document.addEventListener('submit', function (e) {
        var form = e.target;
        if (!form || !form.matches || !form.matches('[data-email-test]')) return;
        e.preventDefault();
        var btn = form.querySelector('button[type="submit"]');
        var out = form.querySelector('[data-email-test-result]');
        if (btn) btn.disabled = true;
        if (out) { out.textContent = emailTestText.sending; out.className = 'text-xs font-medium text-gray-500'; }
        fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { 'X-Requested-With': 'fetch' },
        })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            if (out) {
              out.textContent = d.message || (d.ok ? emailTestText.sent : emailTestText.failed);
              out.className = 'text-xs font-medium ' + (d.ok ? 'text-green-600' : 'text-red-600');
            }
          })
          .catch(function () {
            if (out) { out.textContent = emailTestText.requestFailed; out.className = 'text-xs font-medium text-red-600'; }
          })
          .then(function () { if (btn) btn.disabled = false; });
      });
    })();
  </script>
</AdminLayout>

<script>
  // The logo picker sets the hidden key and submits, so choosing an image saves
  // in one step. "Retirer le logo" clears the field first, and setSetting treats an
  // empty value as a delete — restoring the text store name.
  document.addEventListener('media:selected', (event) => {
    const field = document.querySelector<HTMLInputElement>('[data-logo-key]');
    if (!field) return; // another picker on the page (none today) — ignore
    field.value = (event as CustomEvent).detail.imageKey;
    field.form?.submit();
  });

  document.querySelector('[data-logo-remove]')?.addEventListener('click', (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    const field = button.form?.querySelector<HTMLInputElement>('[data-logo-key]');
    if (field) field.value = '';
  });
</script>
