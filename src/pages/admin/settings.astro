---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import MediaPicker from '../../features/media/MediaPicker.astro';
import { setLogoFromMedia } from '../../features/media/db';
import { homeTargetIsValid } from '../../features/settings/home';
import { listPublishedPageOptions, getPageByPublicId } from '../../features/pages/db';
import {
  listProducts,
  getProductsByIds,
  getProductByPublicId,
} from '../../features/products/db';
import { parsePublicId } from '../../features/ids/publicId';
import { mediaUrl } from '../../features/media/url';
import { getConfig, formatPrice } from '../../config';
import {
  isMethodAvailable,
  isPaymentMethod,
  type PaymentMethod,
} from '../../features/payments';
import {
  getStoreSettings,
  setSetting,
  setPaymentMethodDisabled,
  setFeatureEnabled,
} from '../../features/settings/db';
import {
  getSecret,
  setSecret,
  vaultReady,
  type SecretName,
} from '../../features/secrets/store';
import {
  featureAvailability,
  lightningConfigurationError,
  semanticSearchAvailable,
  turnstileConfigured,
  type RuntimeCapabilities,
} from '../../features/settings/availability';
import { getEmailProvider } from '../../features/email';
import { normalizeTimeZone, allTimeZones } from '../../features/settings/timeZone';
import { WEIGHT_UNITS, isWeightUnit } from '../../features/shipping/weight';
import { shippingFor } from '../../features/shipping/effective';
import SecretField from '../../components/SecretField.astro';
import MethodToggle from '../../components/MethodToggle.astro';
import { onDemandImageDeliveryAvailable } from '../../features/products/image';
import { catalogIsOrphaned } from '../../features/navigation/db';
import { CACHE_TAG } from '../../features/cache/tags';
import { purgeCacheTags } from '../../features/cache/purge';
import { t, tn } from '../../features/i18n';

const capabilities: RuntimeCapabilities = {
  vault: vaultReady(),
  authSecret: !!env.AUTH_SECRET,
  images: !!env.IMAGES,
  emailBinding: !!env.EMAIL,
  ai: !!env.AI,
  vectorize: !!env.VECTORIZE,
};

// Runtime mutations (POST). On success set a one-time flash cookie and redirect to a
// CLEAN url (no ?msg lingering) — the GET below reads + clears it (Post/Redirect/Get).
let validationError = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('_action');
  // Each section submits its keys as `secret:<name>` inputs (blank = keep) plus an
  // optional `clear:<name>` checkbox (remove). Process them with the section's save.
  const applySecrets = async (names: SecretName[]) => {
    for (const n of names) {
      try {
        if (String(form.get(`clear:${n}`)) === '1') await setSecret(env.DB, n, null);
        else {
          const v = String(form.get(`secret:${n}`) ?? '').trim();
          if (v) await setSecret(env.DB, n, v);
        }
      } catch {
        // No SECRETS_KEK → can't store; ignore (the UI gates key inputs on the KEK).
      }
    }
  };
  if (action === 'toggle_payment') {
    const method = String(form.get('method') ?? '');
    // `disabled` carries the NEW state the click applies (1 = turn off, 0 = turn on).
    const disabled = String(form.get('disabled')) === '1';
    const current = await getStoreSettings(env.DB);
    if (!isPaymentMethod(method)) {
      validationError = t('admin.settings.error.unknownPaymentMethod');
    } else if (!disabled && !isMethodAvailable(method, current, capabilities.vault)) {
      validationError = t('admin.settings.error.configureMethodFirst');
    } else {
      await setPaymentMethodDisabled(env.DB, method, disabled);
    }
  } else if (action === 'toggle_feature') {
    const feature = String(form.get('feature') ?? '');
    const on = String(form.get('enabled')) === '1'; // `enabled` carries the NEW state
    if (feature === 'cart_enabled' || feature === 'buy_now_enabled') {
      await setFeatureEnabled(env.DB, feature, on);
    } else if (
      feature === 'discounts_enabled' ||
      feature === 'tax_enabled' ||
      feature === 'accounts_enabled' ||
      feature === 'image_optimize' ||
      feature === 'shipping_enabled'
    ) {
      let prerequisiteError = '';
      if (on && (feature === 'discounts_enabled' || feature === 'tax_enabled')) {
        const stripeSecret = await getSecret(env.DB, 'stripe_secret_key');
        const stripeWebhook = await getSecret(env.DB, 'stripe_webhook_secret');
        if (!stripeSecret || !stripeWebhook) {
          prerequisiteError = t('admin.settings.error.stripeFirst');
        }
      } else if (on && feature === 'accounts_enabled') {
        if (!env.AUTH_SECRET) {
          prerequisiteError = t('admin.settings.error.authSecretFirst');
        } else if (!(await getEmailProvider())) {
          prerequisiteError = t('admin.settings.error.emailFirst');
        }
      } else if (on && feature === 'image_optimize' && !env.IMAGES) {
        prerequisiteError = t('admin.settings.error.imagesBindingFirst');
      }
      if (prerequisiteError) {
        validationError = prerequisiteError;
      } else {
        // These default OFF, so store an explicit '1'/'0' (absent = inherit config).
        await setSetting(env.DB, feature, on ? '1' : '0');
      }
    }
  } else if (action === 'save_weight_unit') {
    // Display/input preference only: stored weights stay in grams, so changing the
    // unit never rewrites a single product row — forms simply re-render converted.
    const unit = String(form.get('weight_unit') ?? '');
    await setSetting(env.DB, 'weight_unit', isWeightUnit(unit) && unit !== 'g' ? unit : '');
  } else if (action === 'save_store') {
    // Empty → setSetting deletes the row → falls back to the STORE_NAME default.
    await setSetting(env.DB, 'store_name', String(form.get('store_name') ?? '').trim());
    const zone = normalizeTimeZone(String(form.get('time_zone') ?? ''));
    if (zone) {
      await setSetting(env.DB, 'time_zone', zone);
    } else {
      validationError = t('admin.settings.error.timeZone');
    }
  } else if (action === 'save_logo') {
    const key = String(form.get('logo_image_key') ?? '').trim();
    if (!key) {
      // Empty → setSetting deletes the row → the header falls back to text.
      await setSetting(env.DB, 'logo_image_key', '');
    } else if (!(await setLogoFromMedia(env.DB, key))) {
      // One guarded statement, sourced from `media`: checking first and writing
      // second leaves a window where the file is deleted between the two, which
      // would persist a key that renders a broken logo on every page.
      validationError = t('admin.settings.error.logoMissing');
    }
  } else if (action === 'save_home') {
    // The selector submits public IDs (page:page_… / product:prod_…); resolve
    // them to the stored integer form here at the boundary. The stored setting
    // keeps its existing `page:<id>` / `product:<id>` shape — it never leaves
    // the server.
    const choice = String(form.get('home_page') ?? '').trim();
    let stored: string | null = null;
    if (choice === '') {
      stored = '';
    } else if (choice.startsWith('page:')) {
      const pid = parsePublicId(choice.slice('page:'.length), 'page');
      const page = pid ? await getPageByPublicId(env.DB, pid) : null;
      if (page) stored = `page:${page.id}`;
    } else if (choice.startsWith('product:')) {
      const pid = parsePublicId(choice.slice('product:'.length), 'product');
      const product = pid ? await getProductByPublicId(env.DB, pid) : null;
      if (product) stored = `product:${product.id}`;
    }
    if (stored !== null && (await homeTargetIsValid(env.DB, stored))) {
      // '' deletes the row, so the catalog list is the default by absence.
      await setSetting(env.DB, 'home_page', stored);
    } else {
      // Draft pages and inactive products are not valid targets — the same rule
      // the storefront resolves by, so the setting cannot point somewhere that
      // would silently fall back.
      validationError = t('admin.settings.error.homeTarget');
    }
  } else if (action === 'save_announcement') {
    // The message doubles as the on/off switch: empty deletes the row (setSetting
    // treats '' as a delete), so there's no enabled flag to drift out of sync.
    const message = String(form.get('announcement') ?? '').trim().slice(0, 200);
    const href = String(form.get('announcement_href') ?? '').trim();
    // The href is rendered into an <a>, so only allow a same-site path or an
    // http(s) URL — never a javascript:/data: scheme, even from an admin.
    const safeHref =
      !href ||
      (href.startsWith('/') && !href.startsWith('//')) ||
      /^https?:\/\//i.test(href);
    if (!safeHref) {
      validationError = t('admin.settings.error.announcementHref');
    } else {
      await setSetting(env.DB, 'announcement', message);
      await setSetting(env.DB, 'announcement_href', message ? href : '');
    }
  } else if (action === 'set_image_delivery') {
    const delivery = String(form.get('image_delivery') ?? '');
    if (delivery === 'cloudflare') {
      if (!onDemandImageDeliveryAvailable(getConfig().images.baseUrl)) {
        validationError = t('admin.settings.error.onDemandImages');
      } else {
        await setSetting(env.DB, 'image_delivery', 'cloudflare');
      }
    } else if (delivery === 'original') {
      await setSetting(env.DB, 'image_delivery', null);
    } else {
      validationError = t('admin.settings.error.imageDelivery');
    }
  } else if (action === 'set_search') {
    // Runtime search backend. 'vector' needs the AI + VECTORIZE bindings; the
    // search dispatcher falls back to keyword (FTS5) at query time if they're absent.
    const provider = String(form.get('provider') ?? '');
    if (provider === 'vector' && !semanticSearchAvailable(capabilities)) {
      validationError = t('admin.settings.error.semanticBindings');
    } else if (provider === 'fts' || provider === 'vector') {
      await setSetting(env.DB, 'search_provider', provider);
    }
  } else if (action === 'save_email') {
    // Whole Email section: config + the Resend key, in one save. Store only the
    // non-default config values so the table stays tidy (absent = default).
    const requestedEnabled = String(form.get('email_enabled')) === '1';
    const ep = String(form.get('email_provider') ?? '');
    const provider = ep === 'cloudflare' ? 'cloudflare' : 'resend';
    await setSetting(env.DB, 'email_provider', provider === 'cloudflare' ? 'cloudflare' : null);
    await setSetting(env.DB, 'email_from', String(form.get('email_from') ?? '').trim() || null);
    await setSetting(env.DB, 'email_from_name', String(form.get('email_from_name') ?? '').trim() || null);
    await setSetting(env.DB, 'email_notify_to', String(form.get('email_notify_to') ?? '').trim() || null);
    await applySecrets(['resend_api_key']);
    const ready =
      provider === 'cloudflare'
        ? !!env.EMAIL
        : !!(await getSecret(env.DB, 'resend_api_key'));
    await setSetting(env.DB, 'email_enabled', requestedEnabled && ready ? null : '0');
    if (requestedEnabled && !ready) {
      validationError =
        provider === 'cloudflare'
          ? t('admin.settings.error.emailBinding')
          : t('admin.settings.error.resendKey');
    }
  } else if (action === 'save_turnstile') {
    const requestedEnabled = String(form.get('turnstile_enabled')) === '1';
    const siteKey = String(form.get('turnstile_site_key') ?? '').trim();
    await setSetting(env.DB, 'turnstile_site_key', siteKey || null);
    await applySecrets(['turnstile_secret_key']);
    const secret = await getSecret(env.DB, 'turnstile_secret_key');
    const ready = !!siteKey && !!secret;
    await setSetting(env.DB, 'turnstile_enabled', requestedEnabled && ready ? '1' : null);
    if (requestedEnabled && !ready) {
      validationError = t('admin.settings.error.turnstileKeys');
    }
  } else if (action === 'save_default') {
    const prov = String(form.get('payment_provider') ?? '');
    const current = await getStoreSettings(env.DB);
    const disabled = new Set(current.disabledPaymentMethods);
    if (
      !isPaymentMethod(prov) ||
      !isMethodAvailable(prov, current, capabilities.vault) ||
      disabled.has(prov)
    ) {
      validationError = t('admin.settings.error.defaultMethod');
    } else {
      await setSetting(
        env.DB,
        'payment_provider',
        prov === 'stripe' ? null : prov,
      );
    }
  } else if (action === 'save_stripe') {
    await applySecrets(['stripe_secret_key', 'stripe_webhook_secret']);
  } else if (action === 'save_lightning') {
    const requestedBackend = String(form.get('lightning_backend') ?? '');
    if (requestedBackend !== 'lnbits' && requestedBackend !== 'phoenixd') {
      validationError = t('admin.settings.error.lightningBackend');
    } else {
      const backend = requestedBackend;
      const urlField = backend === 'lnbits' ? 'lnbits_url' : 'phoenixd_url';
      const secretName: SecretName =
        backend === 'lnbits' ? 'lnbits_api_key' : 'phoenixd_password';
      const url = String(form.get(urlField) ?? '').trim();
      const suppliedSecret = String(form.get(`secret:${secretName}`) ?? '').trim();
      const clearSecret = form.get(`clear:${secretName}`) === '1';
      const existingSecret = clearSecret ? null : await getSecret(env.DB, secretName);
      validationError =
        lightningConfigurationError(
          backend,
          url,
          !clearSecret && (!!suppliedSecret || !!existingSecret),
        ) ?? '';

      if (!validationError) {
        await setSetting(env.DB, 'lightning_backend', backend === 'lnbits' ? 'lnbits' : null);
        await setSetting(env.DB, urlField, url);
        await applySecrets([secretName]);
      }
    }
  } else if (action === 'save_shippo') {
    await applySecrets(['shippo_api_key']);
  } else if (action === 'save_opennode') {
    await setSetting(env.DB, 'opennode_api_url', String(form.get('opennode_api_url') ?? '').trim() || null);
    await applySecrets(['opennode_api_key']);
  }
  // Admin saves are deliberately coarse and infrequent. Purge both public
  // dependency roots after the write rather than risk a newly added setting
  // silently missing its invalidation edge.
  await purgeCacheTags([CACHE_TAG.shell, CACHE_TAG.catalog]);
  // Background (JS) submit → no redirect; the client re-fetches + swaps the section.
  if (Astro.request.headers.get('x-requested-with') === 'fetch') {
    return validationError
      ? new Response(validationError, { status: 400 })
      : new Response(null, { status: 204 });
  }
  // Invalid timezone: render the form with the error and retain the saved zone.
  if (!validationError) {
    // No-JS path: Post/Redirect/Get with a one-time flash banner.
    Astro.cookies.set('flash', t('admin.settings.flash.updated'), {
      path: '/admin/settings',
      maxAge: 15,
      httpOnly: true,
      sameSite: 'lax',
    });
    return Astro.redirect('/admin/settings', 303);
  }
}

const cfg = getConfig();
const { currency } = cfg;

// One-time flash (set above) → shown once, then cleared. Also accepts ?msg for
// redirects from other endpoints (the reindex API); the inline script strips any
// lingering ?msg from the URL after it's shown.
const flash = Astro.cookies.get('flash')?.value ?? null;
if (flash) Astro.cookies.delete('flash', { path: '/admin/settings' });
const msg = validationError || flash || Astro.url.searchParams.get('msg');

const settings = await getStoreSettings(env.DB);
const disabledSet = new Set(settings.disabledPaymentMethods);
// Store name is a runtime overlay (this field / the setup wizard) over STORE_NAME.
const storeName = settings.storeName ?? cfg.storeName;
const logoUrl = settings.logoImageKey ? mediaUrl(settings.logoImageKey, cfg.images.baseUrl) : null;
// Options for the home-page selector. Only published pages and active products
// are offered, matching what the storefront will actually resolve. The product
// list is bounded — a selector is not a place to render a whole catalog.
const HOME_PRODUCT_CHOICES = 100;
const homePages = await listPublishedPageOptions(env.DB);
const homeProducts = await listProducts(env.DB, HOME_PRODUCT_CHOICES, 0, 'name COLLATE NOCASE');
const homeChoice = settings.homePage ?? '';
// The list is bounded, so a store with more products than that could render a
// selector with NO option matching the current choice. The browser would then
// show the first option — "Liste des produits (par défaut)" — and saving the form would
// silently clear a perfectly valid setting. Pull the chosen one in explicitly.
const chosenProductId = homeChoice.startsWith('product:') ? Number(homeChoice.slice(8)) : null;
if (chosenProductId && !homeProducts.some((p) => p.id === chosenProductId)) {
  // getProductsByIds filters on active = 1. getProduct does not, and pulling an
  // INACTIVE product back in would show it as the selected home page while the
  // storefront had already fallen back — and saving it would fail validation,
  // leaving a form that cannot be submitted without changing the answer.
  const [chosen] = await getProductsByIds(env.DB, [chosenProductId]);
  if (chosen) homeProducts.unshift(chosen);
}
// A stored choice with no matching option — deactivated product, unpublished or
// deleted page. The select falls back to showing "Liste des produits (par défaut)", which
// is what the storefront renders too, so say why rather than letting the setting
// look like it vanished on its own.
const homeChoiceMissing =
  homeChoice !== '' &&
  !homePages.some((page) => `page:${page.id}` === homeChoice) &&
  !homeProducts.some((product) => `product:${product.id}` === homeChoice);
// Pointing / at a page or product moves the catalog to /products, and the header
// no longer surfaces it automatically — navigation is merchant-managed now. If no
// menu links the catalog, the shop becomes unreachable from the storefront. Warn
// at the point of the decision rather than silently editing a menu the merchant
// curates; they may genuinely want it unlinked.
const catalogOrphaned = await catalogIsOrphaned(env.DB, settings.homePage);
const timeZone = settings.timeZone ?? cfg.timeZone;
const weightUnit = settings.weightUnit;
// One control, one source of truth: the old on/off toggle lived here and the zones
// lived in store.config.ts, which could disagree. Now Shipping owns both.
const effectiveShipping = shippingFor(settings).config;
const announcement = settings.announcement ?? '';
const announcementHref = settings.announcementHref ?? '';
const timeZones = allTimeZones();

// Search backend: runtime overlay (toggle below) over the build-time default.
// Semantic search needs the AI + VECTORIZE bindings; without them the toggle is
// disabled and search stays on keyword (FTS5).
const searchProvider = settings.searchProvider ?? cfg.search.provider;
const vectorBindingsReady = semanticSearchAvailable(capabilities);
const onDemandImagesReady = onDemandImageDeliveryAvailable(cfg.images.baseUrl);
// The cursor is the last processed product's prod_ public ID ('' = start) —
// no numeric row id travels through admin URLs or form values.
const reindexCursor = parsePublicId(Astro.url.searchParams.get('reindex_cursor'), 'product') ?? '';
const reindexProcessedValue = Number(Astro.url.searchParams.get('reindex_processed'));
const reindexProcessed =
  Number.isInteger(reindexProcessedValue) && reindexProcessedValue > 0
    ? reindexProcessedValue
    : 0;

// Storefront feature switches (runtime, default on).
const baseFeatureRows: { key: string; label: string; desc: string; on: boolean }[] = [
  {
    key: 'cart_enabled',
    label: t('admin.settings.feature.cart.label'),
    desc: t('admin.settings.feature.cart.desc'),
    on: settings.cartEnabled,
  },
  {
    key: 'buy_now_enabled',
    label: t('admin.settings.feature.buyNow.label'),
    desc: t('admin.settings.feature.buyNow.desc'),
    on: settings.buyNowEnabled,
  },
  {
    key: 'discounts_enabled',
    label: t('admin.settings.feature.discounts.label'),
    desc: t('admin.settings.feature.discounts.desc'),
    on: settings.discountsEnabled ?? cfg.discounts.enabled,
  },
  {
    key: 'tax_enabled',
    label: t('admin.settings.feature.tax.label'),
    desc: t('admin.settings.feature.tax.desc'),
    on: settings.taxEnabled ?? cfg.tax.enabled,
  },
  {
    key: 'accounts_enabled',
    label: t('admin.settings.feature.accounts.label'),
    desc: t('admin.settings.feature.accounts.desc'),
    on: settings.accountsEnabled ?? cfg.features.accounts,
  },
  {
    key: 'image_optimize',
    label: t('admin.settings.feature.imageOptimize.label'),
    desc: t('admin.settings.feature.imageOptimize.desc'),
    on: settings.imageOptimize ?? cfg.images.optimizeOnUpload,
  },
];
const featureRows = baseFeatureRows.map((row) => ({
  ...row,
  ...featureAvailability(row.key, settings, capabilities),
}));

const paymentMethods: { m: PaymentMethod; label: string }[] = [
  { m: 'stripe', label: t('admin.settings.payments.method.stripe') },
  { m: 'lightning', label: t('admin.settings.payments.method.lightning') },
  { m: 'opennode', label: t('admin.settings.payments.method.opennode') },
  { m: 'demo', label: t('admin.settings.payments.method.demo') },
];
const pmRows = paymentMethods.map((r) => {
  const installed = isMethodAvailable(r.m, settings, capabilities.vault);
  return { ...r, installed, enabled: installed && !disabledSet.has(r.m) };
});

// Payment config (default rail + Lightning node) — D1 settings; the keys are in the
// vault below.
const payments = {
  provider: settings.paymentProvider,
  lightningBackend: settings.lightningBackend,
  lnbitsUrl: settings.lnbitsUrl ?? '',
  phoenixdUrl: settings.phoenixdUrl ?? '',
  opennodeApiUrl: settings.opennodeApiUrl ?? '',
};

// Encrypted key vault (features/secrets). Keys are write-only — stored AES-GCM in
// D1 under SECRETS_KEK, never echoed back. Needs a KEK; without it the vault is
// dormant (the store runs demo-only).
const vault = capabilities.vault;
const inD1 = (name: string) => settings.configuredSecrets.includes(name);
// Per-method toggle/installed state, keyed by method for the cards below.
const pmMap = Object.fromEntries(pmRows.map((r) => [r.m, r])) as Record<
  string,
  (typeof pmRows)[number]
>;

// Email integration — config lives in D1 (overlaid on the build-time defaults), the
// Resend API key in the vault. `from` defaults to the build-time config when blank.
const email = {
  enabled: settings.emailEnabled,
  provider: settings.emailProvider,
  from: settings.emailFrom ?? '',
  fromName: settings.emailFromName ?? '',
  fromPlaceholder: cfg.email.from,
  notifyTo: settings.emailNotifyTo ?? '',
  notifyPlaceholder: cfg.email.notifyTo || t('admin.settings.email.notifyPlaceholder'),
};
const resendStoredInD1 = inD1('resend_api_key');
const resendReady = !!(await getSecret(env.DB, 'resend_api_key'));
// The Cloudflare `send_email` binding is present when declared in wrangler.jsonc.
// Presence ≠ deliverable: sending still needs a Workers Paid plan + an onboarded
// sender domain (that only fails at send time). Mirrors the Search section's
// AI/Vectorize binding check.
const emailBindingReady = !!env.EMAIL;
const selectedEmailReady =
  email.provider === 'cloudflare' ? emailBindingReady : resendReady;

// Turnstile (bot protection) — enabled + sitekey in D1, secret in the vault.
const turnstile = {
  enabled: settings.turnstileEnabled,
  siteKey: settings.turnstileSiteKey ?? '',
};
const turnstileSecretInD1 = inD1('turnstile_secret_key');
const turnstileSecretReady = !!(await getSecret(env.DB, 'turnstile_secret_key'));
const turnstileReady =
  turnstileConfigured(settings, capabilities) && turnstileSecretReady;

// Jump sub-nav targets.
const sections = [
  { id: 'general', label: t('admin.settings.section.general') },
  { id: 'images', label: t('admin.settings.section.images') },
  { id: 'payments', label: t('admin.settings.section.payments') },
  { id: 'email', label: t('admin.settings.section.email') },
  { id: 'turnstile', label: t('admin.settings.section.turnstile') },
  { id: 'search', label: t('admin.settings.section.search') },
  { id: 'build-time', label: t('admin.settings.section.buildTime') },
];
---

<AdminLayout title={t('admin.settings.title')} active="settings">
  <h1 class="mb-4 font-serif text-3xl tracking-tight">{t('admin.settings.title')}</h1>

  {/* Sticky jump sub-nav — scales the single page without splitting into routes. */}
  <nav
    class="no-scrollbar sticky top-0 z-10 -mx-6 mb-6 flex gap-1 overflow-x-auto border-b border-line bg-paper/90 px-6 py-2 text-xs uppercase tracking-widest backdrop-blur sm:mx-0 sm:px-0"
  >
    {
      sections.map((s) => (
        <a href={`#${s.id}`} class="shrink-0 rounded px-3 py-1 text-gray-500 hover:text-brand">
          {s.label}
        </a>
      ))
    }
  </nav>

  {
    msg && (
      <p
        data-flash
        class={`mb-6 rounded-md border px-3 py-2 text-sm ${
          validationError
            ? 'border-red-200 bg-red-50 text-red-700'
            : 'border-green-200 bg-green-50 text-green-700'
        }`}
      >
        {msg}
      </p>
    )
  }

  {/* ── General: store identity + storefront features (runtime) ───────────── */}
  <section id="general" class="scroll-mt-16">
    <h2 class="mb-2 text-lg font-bold">{t('admin.settings.section.general')}</h2>
    <p class="mb-4 text-sm text-gray-500">
      {t('admin.settings.general.intro')}
    </p>

