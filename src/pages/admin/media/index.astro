---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { formatDate, getConfig } from '../../../config';
import Pagination from '../../../components/Pagination.astro';
import { MEDIA_PAGE_SIZE, countMedia } from '../../../features/media/db';
import { isUnused, usageLinks } from '../../../features/media/usage';
import { mediaUrl } from '../../../features/media/url';
import { loadMediaPage } from '../../api/admin/media';
import { paginate, queryHref } from '../../../pagination';
import { t, tn, formatNumber } from '../../../features/i18n';

const error = Astro.url.searchParams.get('error');

// Count first so paginate() clamps an out-of-range ?page= to the last real page
// instead of querying past the end and rendering an empty grid.
const total = await countMedia(env.DB);
const { page, offset, totalPages } = paginate(Astro.url.searchParams, total, MEDIA_PAGE_SIZE);
const { items, usage, baseUrl } = await loadMediaPage(MEDIA_PAGE_SIZE, offset);
const hrefFor = (p: number) => queryHref('/admin/media', { page: p > 1 ? p : undefined });

// See the note in admin/pages: the shared formatter, in the store's time zone.
const timeZone = Astro.locals.settings?.timeZone ?? getConfig().timeZone;

/** Legacy rows backfilled from R2 have no size — show nothing, not "0 o". */
function formatSize(bytes: number | null): string | null {
  if (bytes == null) return null;
  if (bytes < 1024) return t('admin.media.size.bytes', { taille: formatNumber(bytes) });
  if (bytes < 1024 * 1024) {
    return t('admin.media.size.kilobytes', { taille: formatNumber(Math.round(bytes / 1024)) });
  }
  const megabytes = formatNumber(bytes / (1024 * 1024), {
    minimumFractionDigits: 1,
    maximumFractionDigits: 1,
  });
  return t('admin.media.size.megabytes', { taille: megabytes });
}
---

<AdminLayout title={t('admin.media.title')} active="media">
  <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="font-serif text-3xl tracking-tight">{t('admin.media.title')}</h1>
      <p class="mt-1 text-sm text-gray-500">
        {tn('admin.media.count.one', 'admin.media.count.other', total)}
        {t('admin.media.intro')}
      </p>
    </div>
  </div>

  {
    error && (
      <p class="mb-6 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        {error}
      </p>
    )
  }

  <form
    method="post"
    action="/api/admin/media"
    enctype="multipart/form-data"
    class="mb-8 flex flex-wrap items-center gap-3 rounded-md border border-line p-4"
  >
    <input
      type="file"
      name="files"
      accept="image/jpeg,image/png,image/webp,image/gif"
      multiple
      required
      class="block w-full text-sm text-gray-600 file:mr-3 file:cursor-pointer file:rounded-md file:border-0 file:bg-brand file:px-4 file:py-2 file:text-xs file:font-medium file:uppercase file:tracking-wider file:text-white hover:file:bg-brand-hover sm:w-auto"
    />
    <button
      type="submit"
      class="rounded-md bg-brand px-4 py-2 text-xs font-medium uppercase tracking-wider text-white hover:bg-brand-hover"
    >
      {t('admin.media.upload')}
    </button>
    <span class="text-xs text-gray-500">{t('admin.media.uploadHint')}</span>
  </form>

  {
    items.length === 0 ? (
      <p class="py-12 text-center text-sm text-gray-500">
        {t('admin.media.empty')}
      </p>
    ) : (
      <ul class="grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-4">
        {items.map((m) => {
          const entry = usage.get(m.id);
          const unused = !!entry && isUnused(entry);
          const size = formatSize(m.size_bytes);
          // Recorded at upload since migration 0029; NULL for anything older, so
          // the line simply omits it rather than showing a placeholder.
          const dimensions = m.width && m.height ? `${m.width} × ${m.height}` : null;
          const url = mediaUrl(m.image_key, baseUrl);
          return (
            <li class="flex flex-col gap-2">
              <div class="aspect-square overflow-hidden rounded-md border border-line bg-gray-50">
                <img
                  src={url}
                  alt={m.original_name}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-contain"
                />
              </div>
              <p class="truncate text-sm" title={m.original_name}>
                {m.original_name}
              </p>
              <p class="text-xs text-gray-500">
                {formatDate(m.created_at, { dateStyle: 'medium' }, timeZone)}
                {dimensions ? ` · ${dimensions}` : ''}
                {size ? ` · ${size}` : ''}
                {!m.mime_type && !size ? ` · ${t('admin.media.legacy')}` : ''}
              </p>
              <p class="text-xs text-gray-600">
                {unused ? (
                  <span class="text-gray-400">{t('admin.media.unused')}</span>
                ) : (
                  <Fragment>
                    {t('admin.media.usedBy')}{' '}
                    {usageLinks(entry!).map((link, index) => (
                      <Fragment>
                        {index > 0 && ', '}
                        <a
                          href={link.href}
                          title={link.title}
                          class="underline decoration-gray-300 underline-offset-2 hover:text-brand"
                        >
                          {link.label}
                        </a>
                      </Fragment>
                    ))}
                  </Fragment>
                )}
              </p>
              <div class="mt-auto flex items-center gap-3 pt-1">
                <button
                  type="button"
                  data-copy-url={url}
                  data-copied-label={t('admin.media.copied')}
                  class="text-xs uppercase tracking-widest text-gray-500 hover:text-brand"
                >
                  {t('admin.media.copyUrl')}
                </button>
                {unused && (
                  <form method="post" action={`/api/admin/media/${m.public_id}`}>
                    <input type="hidden" name="_action" value="delete" />
                    <button
                      type="submit"
                      class="text-xs uppercase tracking-widest text-red-600 hover:text-red-700"
                    >
                      {t('admin.common.delete')}
                    </button>
                  </form>
                )}
              </div>
            </li>
          );
        })}
      </ul>
    )
  }

  <Pagination page={page} totalPages={totalPages} hrefFor={hrefFor} />
</AdminLayout>

<script>
  // Copy-to-clipboard needs JS by nature; everything else on this page is plain
  // forms, so the grid still works with scripting off.
  document.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement)?.closest<HTMLElement>('[data-copy-url]');
    if (!button) return;
    const url = new URL(button.dataset.copyUrl!, location.origin).href;
    try {
      await navigator.clipboard.writeText(url);
      const original = button.textContent;
      button.textContent = button.dataset.copiedLabel ?? original;
      setTimeout(() => {
        button.textContent = original;
      }, 1200);
    } catch {
      // Clipboard blocked (insecure context or denied permission) — leave the
      // label alone rather than claiming a copy that didn't happen.
    }
  });
</script>
