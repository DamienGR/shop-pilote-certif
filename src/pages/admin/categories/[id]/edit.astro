---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import CategoryForm from '../../../../features/categories/CategoryForm.astro';
import {
  getCategoryByPublicId,
  listCategories,
  buildTree,
  flattenTree,
  descendantIds,
} from '../../../../features/categories/db';
import { parsePublicId } from '../../../../features/ids/publicId';
import { t } from '../../../../features/i18n';

// The route param is the cat_ public ID; numeric row ids are not accepted.
const publicId = parsePublicId(Astro.params.id, 'category');
const category = publicId ? await getCategoryByPublicId(env.DB, publicId) : null;

if (!category) {
  return new Response(t('admin.categories.notFound'), { status: 404 });
}

// A category can't be moved under itself or one of its descendants — exclude them.
const blocked = new Set(await descendantIds(env.DB, category.id));
const parentOptions = flattenTree(buildTree(await listCategories(env.DB))).filter(
  (o) => !blocked.has(o.id),
);
const error = Astro.url.searchParams.get('error');
---

<AdminLayout title={t('admin.categories.edit.title', { nom: category.name })} active="categories">
  <a href="/admin/categories" class="text-sm text-gray-500 hover:text-brand">&larr; {t('admin.categories.back')}</a>
  <h1 class="mt-4 mb-6 text-2xl font-bold">{t('admin.categories.edit.heading')}</h1>
  <CategoryForm
    action={`/api/admin/categories/${category.public_id}`}
    submitLabel={t('admin.categories.edit.submit')}
    category={category}
    parentOptions={parentOptions}
    error={error}
  />
</AdminLayout>
