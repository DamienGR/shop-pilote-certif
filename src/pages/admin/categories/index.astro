---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { menuReferencesFor } from '../../../features/navigation/admin';
import {
  listCategories,
  buildTree,
  flattenTree,
  productCounts,
} from '../../../features/categories/db';
import { t } from '../../../features/i18n';

const rows = flattenTree(buildTree(await listCategories(env.DB)));
const counts = await productCounts(env.DB);
// Categories have no draft state, so deletion is the ONLY way one becomes
// unavailable — which makes this the easiest broken link to create silently.
const menuRefs = await menuReferencesFor(env.DB, 'category', rows.map((r) => r.id));
---

<AdminLayout title={t('admin.categories.title')} active="categories">
  <div class="mb-8 flex items-center justify-between">
    <h1 class="font-serif text-3xl tracking-tight">{t('admin.categories.title')}</h1>
    <a
      href="/admin/categories/new"
      class="rounded-md bg-brand px-4 py-2 text-xs font-medium uppercase tracking-wider text-white hover:bg-brand-hover"
    >
      {t('admin.categories.new')}
    </a>
  </div>

  <div class="sm:overflow-x-auto">
    <table class="admin-table w-full text-left text-sm sm:min-w-[40rem]">
    <thead>
      <tr class="border-b border-line text-xs uppercase tracking-widest text-gray-400">
        <th class="py-3 pr-4 font-normal">{t('admin.common.name')}</th>
        <th class="py-3 pr-4 font-normal">{t('admin.categories.column.slug')}</th>
        <th class="py-3 pr-4 font-normal">{t('admin.categories.column.products')}</th>
        <th class="py-3 text-right font-normal">{t('admin.common.actions')}</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((c) => (
          <tr class="border-b border-line">
            <td class="py-3 pr-4">
              <a
                href={`/admin/categories/${c.public_id}/edit`}
                class="inline-block font-medium hover:text-brand"
                style={`padding-left:${c.depth * 20}px`}
              >
                {c.depth > 0 && <span class="text-gray-400">↳ </span>}
                {c.name}
              </a>
            </td>
            <td data-label={t('admin.categories.column.slug')} class="py-3 pr-4 text-gray-500">{c.slug}</td>
            <td data-label={t('admin.categories.column.products')} class="py-3 pr-4 tabular-nums text-gray-500">{counts.get(c.id) ?? 0}</td>
            <td data-label="" class="py-3 text-right">
              <div class="flex justify-end gap-4 text-xs uppercase tracking-widest">
                <a href={`/admin/categories/${c.public_id}/edit`} class="text-accent hover:underline">
                  {t('admin.common.edit')}
                </a>
                <form
                  method="POST"
                  action={`/api/admin/categories/${c.public_id}`}
                  onsubmit={`return confirm('${
                    menuRefs.has(c.id)
                      ? t('admin.categories.confirmDeleteLinked')
                      : t('admin.categories.confirmDelete')
                  }')`}
                >
                  <input type="hidden" name="_action" value="delete" />
                  <button type="submit" class="text-red-600 hover:underline">
                    {t('admin.common.delete')}
                  </button>
                </form>
              </div>
            </td>
          </tr>
        ))
      }
      {
        rows.length === 0 && (
          <tr>
            <td colspan="4" class="py-8 text-center text-gray-400">
              {t('admin.categories.empty')}
            </td>
          </tr>
        )
      }
    </tbody>
    </table>
  </div>
</AdminLayout>
