---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import CategoryForm from '../../../features/categories/CategoryForm.astro';
import { listCategories, buildTree, flattenTree } from '../../../features/categories/db';
import { t } from '../../../features/i18n';

const parentOptions = flattenTree(buildTree(await listCategories(env.DB)));
const error = Astro.url.searchParams.get('error');
---

<AdminLayout title={t('admin.categories.new')} active="categories">
  <a href="/admin/categories" class="text-sm text-gray-500 hover:text-brand">&larr; {t('admin.categories.back')}</a>
  <h1 class="mt-4 mb-6 text-2xl font-bold">{t('admin.categories.new')}</h1>
  <CategoryForm
    action="/api/admin/categories"
    submitLabel={t('admin.categories.create')}
    parentOptions={parentOptions}
    error={error}
  />
</AdminLayout>
