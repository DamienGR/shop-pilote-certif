---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { formatDate, getConfig } from '../../../config';
import { listPages } from '../../../features/pages/db';
import { menuReferencesFor } from '../../../features/navigation/admin';
import { t } from '../../../features/i18n';

const pages = await listPages(env.DB);
// Deleting a page that a menu links to silently shrinks the storefront nav.
// One bounded query for the whole list, so say so before it happens.
const menuRefs = await menuReferencesFor(
  env.DB,
  'page',
  pages.map((p) => p.id),
);
// The shared formatter, like every other admin list. A local Intl instance
// here formatted in en-US and in UTC, so this one screen disagreed with the
// orders and customers lists beside it about both the date's shape and the day
// it fell on (invariant 7: only formatPrice/formatDate name a locale).
const timeZone = Astro.locals.settings?.timeZone ?? getConfig().timeZone;
---

<AdminLayout title={t('admin.pages.title')} active="pages">
  <div class="mb-8 flex items-center justify-between">
    <h1 class="font-serif text-3xl tracking-tight">{t('admin.pages.title')}</h1>
    <a
      href="/admin/pages/new"
      class="rounded-md bg-brand px-4 py-2 text-xs font-medium uppercase tracking-wider text-white hover:bg-brand-hover"
    >
      {t('admin.pages.list.newPage')}
    </a>
  </div>

  {
    pages.length === 0 ? (
      <p class="py-12 text-center text-sm text-gray-500">
        {t('admin.pages.list.empty.before')}
        {' '}
        <a href="/admin/navigation" class="underline hover:text-brand">
          {t('admin.pages.list.empty.link')}
        </a>{' '}
        {t('admin.pages.list.empty.after')}
      </p>
    ) : (
      <div class="sm:overflow-x-auto">
        <table class="admin-table w-full text-left text-sm sm:min-w-[40rem]">
          <thead>
            <tr class="border-b border-line text-xs uppercase tracking-widest text-gray-400">
              <th class="py-3 pr-4 font-normal">{t('admin.pages.field.title')}</th>
              <th class="py-3 pr-4 font-normal">{t('admin.pages.list.col.url')}</th>
              <th class="py-3 pr-4 font-normal">{t('admin.common.status')}</th>
              <th class="py-3 pr-4 font-normal">{t('admin.pages.list.col.updated')}</th>
              <th class="py-3 text-right font-normal">{t('admin.common.actions')}</th>
            </tr>
          </thead>
          <tbody>
            {pages.map((page) => (
              <tr class="border-b border-line">
                <td class="py-3 pr-4">
                  <a href={`/admin/pages/${page.public_id}/edit`} class="font-medium hover:text-brand">
                    {page.title}
                  </a>
                </td>
                <td data-label={t('admin.pages.list.col.url')} class="py-3 pr-4 text-gray-500">
                  /pages/{page.slug}
                </td>
                <td data-label={t('admin.common.status')} class="py-3 pr-4">
                  {page.published ? (
                    <span class="text-gray-600">{t('admin.pages.status.published')}</span>
                  ) : (
                    <span class="text-gray-400">{t('admin.pages.status.draft')}</span>
                  )}
                </td>
                <td data-label={t('admin.pages.list.col.updated')} class="py-3 pr-4 text-gray-500">
                  {formatDate(page.updated_at, { dateStyle: 'medium' }, timeZone)}
                </td>
                <td class="py-3 text-right">
                  <span class="inline-flex items-center gap-3">
                    {page.published !== 0 && (
                      <a
                        href={`/pages/${page.slug}`}
                        target="_blank"
                        rel="noopener"
                        class="text-xs uppercase tracking-widest text-gray-500 hover:text-brand"
                      >
                        {t('admin.common.view')}
                      </a>
                    )}
                    <a
                      href={`/admin/pages/${page.public_id}/edit`}
                      class="text-xs uppercase tracking-widest text-gray-500 hover:text-brand"
                    >
                      {t('admin.common.edit')}
                    </a>
                    <form
                      method="POST"
                      action={`/api/admin/pages/${page.public_id}`}
                      onsubmit={`return confirm('${
                        menuRefs.has(page.id)
                          ? t('admin.pages.list.confirmDeleteLinked')
                          : t('admin.pages.list.confirmDelete')
                      }')`}
                    >
                      <input type="hidden" name="_action" value="delete" />
                      <button
                        type="submit"
                        class="text-xs uppercase tracking-widest text-red-600 hover:text-red-700"
                      >
                        {t('admin.common.delete')}
                      </button>
                    </form>
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</AdminLayout>
