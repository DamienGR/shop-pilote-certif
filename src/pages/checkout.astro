---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import { getConfig, formatPrice } from '../config';
import { readCart, resolveCart } from '../features/cart/cart';
import { getProductByPublicId, type Product } from '../features/products/db';
import { listVariants, getExtrasByPublicIds, type ProductVariant } from '../features/products/variants';
import { parsePublicId } from '../features/ids/publicId';
import {
  claimOrderIdentity,
  deleteGuestAccessIfUnsettled,
} from '../features/orders/guestAccess';
import { lineUnitPriceCents } from '../features/cart/key';
import {
  quoteShipping,
  allowedCountries,
  hasCatchAllZone,
  deliveryMethodOf,
  type ShippingOption,
} from '../features/shipping/calculator';
import { countryOptions, countryName, isCountryCode } from '../features/shipping/countries';
import { shippingFor } from '../features/shipping/effective';
import { shipmentWeightFor } from '../features/shipping/lines';
import { asksRecipientPhone, plausiblePhone } from '../features/shipping/recipient';
import { getRelayPointSearch } from '../features/shipping/boxtal';
import type { PickupPoint, Weekday } from '../features/shipping/provider';
import {
  RELAY_POINTS_SHOWN,
  relayPointOf,
  searchRelayPoints,
  servedPoint,
  type RelayPoint,
} from '../features/shipping/relay';
import { boxtalConfigured } from '../features/settings/availability';
import { vaultReady } from '../features/secrets/store';
import { getLightningBackend } from '../features/payments/lightning';
import { mintLightningOrder } from '../features/payments/lightning-provider';
import {
  DEMO_CHECKOUT_TTL_SECONDS,
  STRIPE_CHECKOUT_TTL_SECONDS,
  RESERVATION_EXPIRY_GRACE_SECONDS,
  isMethodEnabled,
  getPaymentProvider,
} from '../features/payments';
import { productImageUrl } from '../features/products/image';
import { logSafe } from '../features/observability/logSafe';
import {
  reserveInventory,
  releaseInventoryReservation,
} from '../features/orders/reservations';
import { reservationItems } from '../features/orders/reservationItems.ts';
import { purgeStockProductCache } from '../features/cache/purge';
import { paymentRailAction } from '../features/payments/labels';
import { t, tn, formatNumber } from '../features/i18n';
import { consentFor, isAcceptance, readTermsGate } from '../features/legal/terms';

const cfg = getConfig();
const isPost = Astro.request.method === 'POST';
const form = isPost ? await Astro.request.formData() : null;
const fld = (name: string) => (form?.get(name) ?? '').toString().trim();

/**
 * The in-app shipping checkout, shared by every rail that cannot collect a
 * destination on its own hosted page: Lightning has no hosted page at all,
 * OpenNode's ignores addresses, and Demo has none. Stripe usually skips this — it
 * collects the address itself, after the session is created — but comes here
 * where the destination's zone holds a relay rate: its page cannot offer a
 * point, so the address, the rate and the point are all taken here, once, and
 * the session charges the chosen rate alone (api/checkout.ts).
 *
 * Three steps: the address, the rate, and — for a relay rate (ADR 0020) — the
 * point, searched by the server around the address and listed as a form.
 *
 * Gate on the chosen rail being ENABLED (configured and not switched off), not on
 * it being the default, so the method picker can route here whatever the store's
 * default is — and a rail the admin disabled is closed to a crafted POST too.
 * The rail arrives as a query param on the first hop and as a hidden field across
 * the address → shipping steps (the forms post to a bare /checkout).
 */
const IN_APP_RAILS = ['lightning', 'opennode', 'demo', 'stripe'] as const;
type InAppRail = (typeof IN_APP_RAILS)[number];
const requestedRail = (fld('method') || Astro.url.searchParams.get('method') || '').trim();
const rail: InAppRail = (IN_APP_RAILS as readonly string[]).includes(requestedRail)
  ? (requestedRail as InAppRail)
  : 'lightning';
if (!Astro.locals.settings || !isMethodEnabled(rail, Astro.locals.settings))
  return Astro.redirect('/cart', 303);

// Order lines: buy-now (product_id [+ variant/extras]) or the whole cart. All
// selectors arrive as prefixed public IDs (prod_/var_/xtra_ — api/checkout.ts
// routes here with them); numeric row IDs are never accepted.
const productPublicId = parsePublicId(
  fld('product_id') || (Astro.url.searchParams.get('product_id') ?? ''),
  'product',
);
// Express buy-now carries variant + extras — in the query on the first hop, then
// as hidden fields across the address → shipping steps.
const buyNowVariantId = parsePublicId(
  fld('variant_id') || Astro.url.searchParams.get('variant_id') || '',
  'variant',
);
const buyNowExtraIds = (isPost ? form!.getAll('extra') : Astro.url.searchParams.getAll('extra'))
  .map((e) => parsePublicId(e, 'extra'))
  .filter((x): x is string => x !== null);

interface CheckoutLine {
  product: Product;
  qty: number;
  name: string;
  unitPriceCents: number;
  variantId: number | null;
  /** Carried (not just its id) because shipment weight needs the variant's own
   *  weight, which overrides the product's. */
  variant: ProductVariant | null;
}
let lines: CheckoutLine[] = [];
if (productPublicId) {
  const product = await getProductByPublicId(env.DB, productPublicId);
  if (product && product.active) {
    const variants = await listVariants(env.DB, product.id);
    const variant =
      variants.length > 0 && buyNowVariantId
        ? (variants.find((v) => v.public_id === buyNowVariantId) ?? null)
        : null;
    const extras = buyNowExtraIds.length
      ? await getExtrasByPublicIds(env.DB, product.id, buyNowExtraIds)
      : [];
    lines = [
      {
        product,
        qty: 1,
        name:
          product.name +
          (variant ? ` — ${variant.label}` : '') +
          (extras.length ? ` (${extras.map((e) => e.label).join(', ')})` : ''),
        unitPriceCents: lineUnitPriceCents(product.price_cents, variant, extras),
        variantId: variant?.id ?? null,
        variant,
      },
    ];
  }
} else {
  const { lines: cartLines } = await resolveCart(env.DB, readCart(Astro.cookies));
  lines = cartLines.map((l) => ({
    product: l.product,
    qty: l.qty,
    name:
      l.product.name +
      (l.variant ? ` — ${l.variant.label}` : '') +
      (l.extras.length ? ` (${l.extras.map((e) => e.label).join(', ')})` : ''),
    unitPriceCents: l.unitPriceCents,
    variantId: l.variant?.id ?? null,
    variant: l.variant,
  }));
}
if (lines.length === 0) return Astro.redirect('/cart', 303);

const subtotalCents = lines.reduce((s, l) => s + l.unitPriceCents * l.qty, 0);
const currency = cfg.currency;
const effectiveShipping = shippingFor(Astro.locals.settings).config;
const knownCountries = allowedCountries(effectiveShipping);
const shipsAnywhere = hasCatchAllZone(effectiveShipping);
// Cloudflare's GeoIP country (the CF-IPCountry request header): the default
// destination when it's one we ship to. A guess, so it only seeds the selector —
// the shopper can always change it. 'XX'/'T1' fail isCountryCode and fall through.
const geoCountry = String(Astro.request.headers.get('cf-ipcountry') ?? '').toUpperCase();
const geoDefault =
  isCountryCode(geoCountry) && (shipsAnywhere || knownCountries.includes(geoCountry))
    ? geoCountry
    : null;
// The choices the address form offers: every shippable country, by name. Explicit
// zones list their codes; a catch-all store offers the whole ISO list.
const destinationChoices = shipsAnywhere
  ? countryOptions()
  : knownCountries.map((code) => ({ code, name: countryName(code) })).sort((a, b) =>
      a.name.localeCompare(b.name),
    );
// Weight (and whether shipping applies at all) always comes from the current D1
// rows resolved above — never from the posted form.
const shipment = shipmentWeightFor(lines);
// Asked with the address once the shop buys its labels from Boxtal, which
// refuses one without it (features/shipping/recipient.ts).
const askPhone = asksRecipientPhone(Astro.locals.settings.configuredSecrets, vaultReady());
// Relay rates are quoted only here, the one surface that can let the shopper
// pick a point, and only while Boxtal can both search the points and buy the
// label (ADR 0020).
const relayOn =
  cfg.features.relayPoints && boxtalConfigured(Astro.locals.settings.configuredSecrets, vaultReady());
const carry = productPublicId ?? '';
const carryVariantId = buyNowVariantId ?? '';
const carryExtraIds = buyNowExtraIds;

// One predicate for the checkbox and for the refusal below — see
// features/legal/terms.ts. Open (no consent asked, none required) until the
// merchant publishes the terms page.
const terms = await readTermsGate(env.DB, cfg.legal);
// On the first hop the cart's acceptance arrives in the query (api/checkout.ts);
// past it, only the posted form counts. A query never stands in for a POST.
const termsAccepted = isAcceptance(
  isPost ? fld('accept_terms') : Astro.url.searchParams.get('accept_terms'),
);

const editAddressHref = (() => {
  const params = new URLSearchParams({ method: rail });
  if (carry) params.set('product_id', carry);
  if (carryVariantId) params.set('variant_id', carryVariantId);
  for (const id of carryExtraIds) params.append('extra', id);
  // Going back to the address keeps the acceptance already given.
  if (termsAccepted) params.set('accept_terms', '1');
  return `/checkout?${params}`;
})();

/**
 * Demo orders don't ship anywhere, so the demo rail skips this page entirely:
 * the first GET is treated as a submission of this hard-coded sample address
 * with the first quoted rate, and the shopper lands straight on /pay — one
 * click (Approve) end to end, with the demo banner as the first thing they
 * see. The form only renders for demo in the error fallback (e.g. shipping
 * cannot be quoted). The real-money rails (Lightning/OpenNode) always type.
 */
const DEMO_ADDRESS = {
  email: 'demo@example.com',
  name: 'Client de démonstration',
  line1: '1 rue de la Démonstration',
  line2: '',
  city: 'Villeneuve',
  state: '',
  postal: '75000',
  country: (geoDefault || knownCountries[0] || 'FR').toUpperCase(),
  // From the range ARCEP keeps for fiction: it reaches nobody.
  phone: '06 39 98 00 00',
};
const prefill = rail === 'demo' && !isPost ? DEMO_ADDRESS : null;
// The destination the cart priced a card payment for, when it sent one here.
const cartDestination = (Astro.url.searchParams.get('country') ?? '').toUpperCase();
const cartCountry =
  isCountryCode(cartDestination) && (shipsAnywhere || knownCountries.includes(cartDestination))
    ? cartDestination
    : null;
const addr = {
  email: fld('email') || (prefill?.email ?? ''),
  name: fld('name') || (prefill?.name ?? ''),
  line1: fld('line1') || (prefill?.line1 ?? ''),
  line2: fld('line2') || (prefill?.line2 ?? ''),
  city: fld('city') || (prefill?.city ?? ''),
  state: fld('state') || (prefill?.state ?? ''),
  postal: fld('postal') || (prefill?.postal ?? ''),
  country: (fld('country') || prefill?.country || cartCountry || geoDefault || knownCountries[0] || 'US').toUpperCase(),
  phone: askPhone ? fld('phone') || (prefill?.phone ?? '') : '',
};

let stage: 'address' | 'shipping' | 'relay' = 'address';
let options: ShippingOption[] = [];
const errors: string[] = [];
// The points each relay option can be delivered to, by option label: the list
// the rate step vouched for and the point step offers.
const relayPoints = new Map<string, PickupPoint[]>();
// The relay option awaiting its point, while stage is 'relay'.
let relayOption: ShippingOption | null = null;
// Back from the point step to the rates: the rate is chosen again.
const changingRate = isPost && fld('change_rate') !== '';

// Demo submits itself: the sample address on the first GET, no typing.
const submitted = isPost || rail === 'demo';
if (submitted) {
  if (!/.+@.+\..+/.test(addr.email)) errors.push(t('checkout.error.email'));
  if (!addr.name) errors.push(t('checkout.error.name'));
  if (!addr.line1) errors.push(t('checkout.error.line1'));
  if (!addr.city) errors.push(t('checkout.error.city'));
  if (!addr.postal) errors.push(t('checkout.error.postal'));
  if (addr.country.length !== 2) errors.push(t('checkout.error.country'));
  if (askPhone && !plausiblePhone(addr.phone)) errors.push(t('checkout.error.phone'));

  if (errors.length === 0) {
    const relay = relayOn ? await getRelayPointSearch(env.DB) : null;
    const quote = quoteShipping(effectiveShipping, {
      subtotalCents,
      country: addr.country,
      itemWeightGrams: shipment.itemWeightGrams,
      missingWeight: shipment.missingWeight,
      ...(relay && { relayOffers: relay.offers }),
    });
    options = quote.options;
    // A relay rate stays on offer only where its search returns a point: a
    // Boxtal outage or a postcode no network serves takes the rate out of the
    // choice instead of blocking the order (ADR 0020). Cached per offer and
    // address, so the point step and the final post read the same list.
    if (relay && options.some((o) => o.relayOffer !== undefined)) {
      // Absent under `astro dev`; a cacheless search is only a slower one.
      const cache = typeof caches !== 'undefined' ? caches.default : null;
      await Promise.all(
        options.map(async (o) => {
          if (o.relayOffer === undefined) return;
          const found = await searchRelayPoints(relay.points, cache, Astro.url.origin, {
            offer: o.relayOffer,
            country: addr.country,
            postalCode: addr.postal,
            city: addr.city,
            weightGrams: quote.shipmentWeightGrams ?? 0,
            sandbox: relay.sandbox,
          });
          if (found.ok && found.value.length > 0) {
            relayPoints.set(o.label, found.value.slice(0, RELAY_POINTS_SHOWN));
          } else if (!found.ok) {
            // The offer only: the address is the shopper's, and Boxtal's
            // refusal is summarised by its codes in `found.error`, never logged.
            console.error(
              JSON.stringify({ event: 'relay_points_unavailable', offer: o.relayOffer, uncertain: found.uncertain === true }),
            );
          }
        }),
      );
    }
    const relayDropped = options.some((o) => o.relayOffer !== undefined && !relayPoints.has(o.label));
    options = options.filter((o) => o.relayOffer === undefined || relayPoints.has(o.label));
    if (options.length === 0 && relayDropped) {
      errors.push(t('checkout.error.noRelayPoint'));
    } else if (options.length === 0) {
      // Distinguish "we don't ship there" from "we can't price this basket", so the
      // shopper is told something they can act on.
      const missing = quote.omitted.some((o) => o.reason === 'missing_weight');
      const overweight = quote.omitted.some((o) => o.reason === 'overweight');
      if (missing) {
        console.error(
          JSON.stringify({
            event: 'shipping_quote_blocked',
            reason: 'missing_weight',
            country: addr.country.toUpperCase(),
            products: quote.missingWeight.map(
              (m) => lines.find((l) => l.product.id === m.productId)?.product.public_id ?? m.name,
            ),
          }),
        );
        errors.push(
          t('checkout.error.missingWeightFor', {
            produits: quote.missingWeight.map((m) => m.name).join(', '),
          }),
        );
      } else if (overweight) {
        errors.push(t('checkout.error.overweight'));
      } else {
        // Named when it is a real code; a malformed one is echoed as typed,
        // because Intl.DisplayNames throws on it.
        const pays = isCountryCode(addr.country) ? countryName(addr.country) : addr.country;
        errors.push(t('checkout.error.noShippingToCountry', { pays }));
      }
    } else {
      stage = 'shipping';
      // Demo auto-picks the first rate — the rate step is also skipped.
      const chosenLabel = changingRate
        ? ''
        : fld('shipping_label') || (rail === 'demo' ? (options[0]?.label ?? '') : '');
      if (chosenLabel && terms.required && !termsAccepted) {
        // Refused BEFORE the identity claim and the stock hold: a checkout that
        // cannot legally complete must not take inventory off the shelf.
        errors.push(t('checkout.error.terms'));
      } else if (chosenLabel) {
        const chosen = options.find((o) => o.label === chosenLabel);
        // A relay rate needs its point. Only a code the search above served is
        // believed: Boxtal cannot read a point back by its code (ADR 0021), so
        // a posted one is checked against the list, never taken as given.
        let relayPoint: RelayPoint | null = null;
        if (chosen?.relayOffer !== undefined) {
          const points = relayPoints.get(chosen.label) ?? [];
          const posted = fld('relay_point') || (rail === 'demo' ? (points[0]?.code ?? '') : '');
          const served = servedPoint(points, posted);
          if (served) {
            relayPoint = relayPointOf(chosen.relayOffer, served);
          } else {
            stage = 'relay';
            relayOption = chosen;
            if (posted) errors.push(t('checkout.error.relayPointGone'));
          }
        }
        if (!chosen) {
          errors.push(t('checkout.error.noShippingOption'));
        } else if (stage === 'relay') {
          // The point step renders below; nothing is reserved yet.
        } else {
          // Finalize: mint the invoice for subtotal + the chosen shipping.
          // Claim the order's public identity + guest credential BEFORE the
          // provider handoff: the ord_ id ties reservation → pending payment →
          // settled order, and the access token is the only thing guest URLs
          // carry. Reservations keep using the ord_ public id.
          const { publicId, accessToken } = await claimOrderIdentity(env.DB);
          const reservedItems = reservationItems(lines);
          const shippingAddress = {
            name: addr.name,
            line1: addr.line1,
            line2: addr.line2 || null,
            city: addr.city,
            state: addr.state || null,
            postal: addr.postal,
            country: addr.country,
            ...(askPhone && { phone: addr.phone }),
          };
          const reservationTtl =
            rail === 'demo'
              ? DEMO_CHECKOUT_TTL_SECONDS
              : rail === 'stripe'
                ? STRIPE_CHECKOUT_TTL_SECONDS + RESERVATION_EXPIRY_GRACE_SECONDS
                : cfg.payments.lightning.invoiceExpiryMinutes * 60 + 5 * 60;
          const reserved = await reserveInventory(
            env.DB,
            publicId,
            reservedItems,
            reservationTtl,
            rail,
            purgeStockProductCache,
            undefined,
            consentFor(terms, termsAccepted),
            cfg.legal.vatRateBps,
            relayPoint,
            // Stripe's webhook returns no address once its page asked none:
            // the reservation carries this one to the order, and lets it go.
            rail === 'stripe' ? shippingAddress : null,
          );
          if (!reserved) {
            await deleteGuestAccessIfUnsettled(env.DB, publicId);
            errors.push(t('checkout.error.stockGone'));
          } else {
            const itemsJson = JSON.stringify(
              lines.map((l) => ({ id: l.product.id, v: l.variantId, q: l.qty, n: l.name, p: l.unitPriceCents })),
            );
            try {
              // OpenNode, Demo and Stripe reach their adapters with the rate ALREADY
              // chosen, so they charge and snapshot the merchant's real configuration
              // instead of ignoring shipping or guessing at the first option.
              if (rail !== 'lightning') {
                const provider = await getPaymentProvider(rail);
                const result = await provider.createCheckout({
                  lineItems: lines.map((l) => ({
                    name: l.name,
                    amountCents: l.unitPriceCents,
                    currency,
                    quantity: l.qty,
                    // Shown by Stripe's page; the bitcoin rails ignore it.
                    imageUrl: new URL(productImageUrl(l.product.image_key, cfg.images.baseUrl), Astro.url.origin).href,
                  })),
                  // Stripe-only options, as api/checkout.ts sets them.
                  allowPromotionCodes: Astro.locals.settings.discountsEnabled ?? cfg.discounts.enabled,
                  automaticTax: Astro.locals.settings.taxEnabled ?? cfg.tax.enabled,
                  successUrl: `${Astro.url.origin}/order/${accessToken}`,
                  cancelUrl: `${Astro.url.origin}/cart`,
                  orderItemsJson: itemsJson,
                  // Provider metadata NEVER carries the access token.
                  metadata: { public_id: publicId, reservation_id: publicId },
                  accessToken,
                  selectedShipping: {
                    label: chosen.label,
                    amountCents: chosen.amountCents,
                    weightGrams: quote.shipmentWeightGrams,
                    deliveryMethod: deliveryMethodOf(chosen),
                    address: shippingAddress,
                    email: addr.email,
                  },
                });
                return Astro.redirect(result.url, 303);
              }
              const minted = await mintLightningOrder(env.DB, await getLightningBackend(), {
                origin: Astro.url.origin,
                publicId,
                accessToken,
                currency,
                subtotalCents,
                shippingCents: chosen.amountCents,
                shippingLabel: chosen.label,
                shippingWeightGrams: quote.shipmentWeightGrams,
                deliveryMethod: deliveryMethodOf(chosen),
                itemsJson,
                email: addr.email,
                shippingAddress,
                reservationId: publicId,
              });
              if (!minted.payUrl) throw new Error('Lightning backend did not return a payment URL.');
              return Astro.redirect(minted.payUrl, 303);
            } catch (error) {
              // The Lightning node (e.g. LNbits) can be briefly unreachable. Free
              // the whole claim — held stock AND the guest credential — and show
              // a retryable message instead of a 500, so the shopper can try
              // again or pick another method.
              await releaseInventoryReservation(env.DB, publicId, purgeStockProductCache);
              await deleteGuestAccessIfUnsettled(env.DB, publicId);
              console.error(
                JSON.stringify({
                  event: rail === 'lightning' ? 'lightning_invoice_failed' : 'checkout_create_failed',
                  rail,
                  // Stripe now receives the shopper's e-mail from here, and its
                  // refusals can quote it back (invariant 12).
                  message: logSafe(error),
                }),
              );
              errors.push(
                rail === 'lightning'
                  ? t('checkout.error.lightningUnavailable')
                  : t('checkout.error.railUnavailable'),
              );
            }
          }
        }
      }
    }
  }
}

const showShipping = stage === 'shipping';
const showRelay = stage === 'relay' && relayOption !== null;
const hasErrors = errors.length > 0;
// The rate a return from the point step keeps selected.
const preferredLabel = fld('shipping_label');
const checkedLabel = options.some((o) => o.label === preferredLabel) ? preferredLabel : options[0]?.label;
const relayChoices = relayOption ? (relayPoints.get(relayOption.label) ?? []) : [];

const WEEKDAYS: Array<[Weekday, string]> = [
  ['MONDAY', t('checkout.relay.day.MONDAY')],
  ['TUESDAY', t('checkout.relay.day.TUESDAY')],
  ['WEDNESDAY', t('checkout.relay.day.WEDNESDAY')],
  ['THURSDAY', t('checkout.relay.day.THURSDAY')],
  ['FRIDAY', t('checkout.relay.day.FRIDAY')],
  ['SATURDAY', t('checkout.relay.day.SATURDAY')],
  ['SUNDAY', t('checkout.relay.day.SUNDAY')],
];
const distanceLabel = (meters: number | null): string | null =>
  meters == null
    ? null
    : meters < 1000
      ? t('checkout.relay.distanceMeters', { distance: formatNumber(Math.round(meters)) })
      : t('checkout.relay.distanceKilometers', {
          distance: formatNumber(meters / 1000, { maximumFractionDigits: 1 }),
        });
---

<Layout title={t('checkout.title')} description={t('checkout.metaDescription')}>
  <div class="mx-auto max-w-lg">
    {
      rail === 'demo' && (
        <div class="mb-6 rounded-lg border-2 border-amber-400 bg-amber-50 px-4 py-4 text-center text-amber-900">
          <p class="text-base font-bold uppercase tracking-wide">{t('checkout.demo.banner')}</p>
          <p class="mt-1 text-sm">
            {t('checkout.demo.explain')}
            <code class="rounded bg-amber-100 px-1">demo</code> {t('checkout.demo.explainAfter')}
          </p>
        </div>
      )
    }
    <h1 class="mb-1 font-serif text-3xl tracking-tight sm:text-4xl">{t('checkout.title')}</h1>
    <p class="mb-6 text-sm text-muted">
      {t('checkout.subtotal', { montant: formatPrice(subtotalCents, currency) })} ·{' '}
      {tn('cart.items.one', 'cart.items.other', lines.length)}
    </p>

    {
      hasErrors && (
        <ul class="mb-4 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-700">
          {errors.map((e) => (
            <li>{e}</li>
          ))}
        </ul>
      )
    }

    {
      showRelay && relayOption ? (
        <form method="POST" action="/checkout" class="space-y-4">
          <input type="hidden" name="method" value={rail} />
          <input type="hidden" name="product_id" value={carry} />
          {carryVariantId && <input type="hidden" name="variant_id" value={carryVariantId} />}
          {carryExtraIds.map((id) => (
            <input type="hidden" name="extra" value={id} />
          ))}
          <input type="hidden" name="email" value={addr.email} />
          <input type="hidden" name="name" value={addr.name} />
          <input type="hidden" name="line1" value={addr.line1} />
          <input type="hidden" name="line2" value={addr.line2} />
          <input type="hidden" name="city" value={addr.city} />
          <input type="hidden" name="state" value={addr.state} />
          <input type="hidden" name="postal" value={addr.postal} />
          <input type="hidden" name="country" value={addr.country} />
          {askPhone && <input type="hidden" name="phone" value={addr.phone} />}
          <input type="hidden" name="shipping_label" value={relayOption.label} />

          <div class="rounded-lg border border-line bg-surface p-4 text-sm">
            <div class="mb-1 font-medium">{t('checkout.shipTo')}</div>
            <div class="text-muted">
              {addr.name}, {addr.line1}
              {addr.line2 ? `, ${addr.line2}` : ''}, {addr.city} {addr.state} {addr.postal}, {addr.country}
              {askPhone && <div>{t('checkout.phoneOnFile', { numero: addr.phone })}</div>}
              <div>
                {t('checkout.relay.rateChosen', {
                  tarif: relayOption.label,
                  montant:
                    relayOption.amountCents === 0
                      ? t('checkout.shippingFree')
                      : formatPrice(relayOption.amountCents, currency),
                })}
              </div>
            </div>
            <a href={editAddressHref} class="mt-2 inline-block text-xs font-medium text-accent">
              {t('checkout.editAddress')}
            </a>
          </div>

          <fieldset class="space-y-2">
            <legend class="mb-1 text-sm font-medium">{t('checkout.relay.choose')}</legend>
            <p class="text-xs text-faint">{t('checkout.relay.near', { lieu: `${addr.postal} ${addr.city}` })}</p>
            {relayChoices.map((p, i) => (
              <label class="block cursor-pointer rounded-lg border border-line bg-surface p-3 text-sm has-[:checked]:border-brand">
                <span class="flex items-start gap-2">
                  <input type="radio" name="relay_point" value={p.code} checked={i === 0} required class="mt-1" />
                  <span class="min-w-0">
                    <span class="font-medium">{p.name}</span>
                    {p.locker && <span class="block text-xs text-faint">{t('checkout.relay.locker')}</span>}
                    <span class="block text-muted">
                      {p.street}, {p.postalCode} {p.city}
                    </span>
                    {distanceLabel(p.distanceMeters) && (
                      <span class="block text-xs text-faint">{distanceLabel(p.distanceMeters)}</span>
                    )}
                    {p.hours && (
                      <details class="mt-1 text-xs text-faint">
                        <summary class="cursor-pointer">{t('checkout.relay.hours')}</summary>
                        <dl class="mt-1 grid grid-cols-[auto_1fr] gap-x-3">
                          {WEEKDAYS.map(([day, dayLabel]) => (
                            <>
                              <dt>{dayLabel}</dt>
                              <dd>
                                {p.hours![day].length === 0
                                  ? t('checkout.relay.closed')
                                  : p.hours![day].map((slot) => `${slot.opens}–${slot.closes}`).join(', ')}
                              </dd>
                            </>
                          ))}
                        </dl>
                      </details>
                    )}
                  </span>
                </span>
              </label>
            ))}
          </fieldset>

          {
            terms.required && (
              <label class="flex items-start gap-2 text-sm">
                <input
                  type="checkbox"
                  name="accept_terms"
                  value="on"
                  required
                  checked={termsAccepted}
                  class="mt-1 accent-brand"
                />
                <span>
                  {t('terms.accept')}{' '}
                  <a href={terms.href} class="underline hover:text-accent">
                    {t('terms.linkLabel')}
                  </a>{' '}
                  ({t('terms.version', { version: terms.version })}).
                </span>
              </label>
            )
          }
          <button
            type="submit"
            class="w-full rounded-md bg-brand px-4 py-2.5 font-medium text-on-brand hover:bg-brand-hover"
          >
            {paymentRailAction(rail)} →
          </button>
          <button
            type="submit"
            name="change_rate"
            value="1"
            formnovalidate
            class="w-full text-center text-xs font-medium text-accent"
          >
            {t('checkout.relay.changeRate')}
          </button>
        </form>
      ) : showShipping ? (
        <form method="POST" action="/checkout" class="space-y-4">
          <input type="hidden" name="method" value={rail} />
          <input type="hidden" name="product_id" value={carry} />
          {carryVariantId && <input type="hidden" name="variant_id" value={carryVariantId} />}
          {carryExtraIds.map((id) => (
            <input type="hidden" name="extra" value={id} />
          ))}
          <input type="hidden" name="email" value={addr.email} />
          <input type="hidden" name="name" value={addr.name} />
          <input type="hidden" name="line1" value={addr.line1} />
          <input type="hidden" name="line2" value={addr.line2} />
          <input type="hidden" name="city" value={addr.city} />
          <input type="hidden" name="state" value={addr.state} />
          <input type="hidden" name="postal" value={addr.postal} />
          <input type="hidden" name="country" value={addr.country} />
          {askPhone && <input type="hidden" name="phone" value={addr.phone} />}

          <div class="rounded-lg border border-line bg-surface p-4 text-sm">
            <div class="mb-1 font-medium">{t('checkout.shipTo')}</div>
            <div class="text-muted">
              {addr.name}, {addr.line1}
              {addr.line2 ? `, ${addr.line2}` : ''}, {addr.city} {addr.state} {addr.postal}, {addr.country}
              {askPhone && <div>{t('checkout.phoneOnFile', { numero: addr.phone })}</div>}
            </div>
            <a href={editAddressHref} class="mt-2 inline-block text-xs font-medium text-accent">
              {t('checkout.editAddress')}
            </a>
          </div>

          <fieldset class="space-y-2">
            <legend class="mb-1 text-sm font-medium">{t('checkout.shipping')}</legend>
            {options.map((o) => (
              <label class="flex cursor-pointer items-center justify-between rounded-lg border border-line bg-surface p-3 text-sm has-[:checked]:border-brand">
                <span class="flex items-center gap-2">
                  <input type="radio" name="shipping_label" value={o.label} checked={o.label === checkedLabel} />
                  <span>
                    {o.label}
                    {o.relayOffer !== undefined && (
                      <span class="block text-xs text-faint">{t('checkout.relay.rateHint')}</span>
                    )}
                  </span>
                </span>
                <span class="text-muted">
                  {o.amountCents === 0 ? t('checkout.shippingFree') : formatPrice(o.amountCents, currency)} ·{' '}
                  {t('checkout.total')}{' '}
                  {formatPrice(subtotalCents + o.amountCents, currency)}
                </span>
              </label>
            ))}
          </fieldset>

          {
            terms.required && (
              <label class="flex items-start gap-2 text-sm">
                <input
                  type="checkbox"
                  name="accept_terms"
                  value="on"
                  required
                  checked={termsAccepted}
                  class="mt-1 accent-brand"
                />
                <span>
                  {t('terms.accept')}{' '}
                  <a href={terms.href} class="underline hover:text-accent">
                    {t('terms.linkLabel')}
                  </a>{' '}
                  ({t('terms.version', { version: terms.version })}).
                </span>
              </label>
            )
          }
          <button
            type="submit"
            class="w-full rounded-md bg-brand px-4 py-2.5 font-medium text-on-brand hover:bg-brand-hover"
          >
            {/* A relay rate leads to the point step, not to the payment: without
                JavaScript the button cannot follow the radio, so it names neither. */}
            {options.some((o) => o.relayOffer !== undefined) ? t('checkout.relay.next') : paymentRailAction(rail)} →
          </button>
        </form>
      ) : (
        <form method="POST" action="/checkout" class="space-y-3">
          <input type="hidden" name="method" value={rail} />
          <input type="hidden" name="product_id" value={carry} />
          {carryVariantId && <input type="hidden" name="variant_id" value={carryVariantId} />}
          {carryExtraIds.map((id) => (
            <input type="hidden" name="extra" value={id} />
          ))}
          {/* The acceptance given on the cart, carried to the step that asks for it. */}
          {terms.required && termsAccepted && <input type="hidden" name="accept_terms" value="on" />}
          <label class="block text-sm">
            <span class="mb-1 block font-medium">{t('checkout.field.email')}</span>
            <input
              type="email"
              name="email"
              value={addr.email}
              required
              class="w-full rounded-md border border-line px-3 py-2"
            />
          </label>
          <label class="block text-sm">
            <span class="mb-1 block font-medium">{t('checkout.field.name')}</span>
            <input type="text" name="name" value={addr.name} required class="w-full rounded-md border border-line px-3 py-2" />
          </label>
          <label class="block text-sm">
            <span class="mb-1 block font-medium">{t('checkout.field.line1')}</span>
            <input type="text" name="line1" value={addr.line1} required class="w-full rounded-md border border-line px-3 py-2" />
          </label>
          <label class="block text-sm">
            <span class="mb-1 block font-medium">{t('checkout.field.line2')}</span>
            <input type="text" name="line2" value={addr.line2} class="w-full rounded-md border border-line px-3 py-2" />
          </label>
          <div class="grid grid-cols-2 gap-3">
            <label class="block text-sm">
              <span class="mb-1 block font-medium">{t('checkout.field.city')}</span>
              <input type="text" name="city" value={addr.city} required class="w-full rounded-md border border-line px-3 py-2" />
            </label>
            <label class="block text-sm">
              <span class="mb-1 block font-medium">{t('checkout.field.state')}</span>
              <input type="text" name="state" value={addr.state} class="w-full rounded-md border border-line px-3 py-2" />
            </label>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <label class="block text-sm">
              <span class="mb-1 block font-medium">{t('checkout.field.postal')}</span>
              <input type="text" name="postal" value={addr.postal} required class="w-full rounded-md border border-line px-3 py-2" />
            </label>
            <label class="block text-sm">
              <span class="mb-1 block font-medium">{t('checkout.field.country')}</span>
              {/* A select, not a code field: shoppers should not need to know ISO
                  codes. Native type-ahead finds a country by typing its name; the
                  value stays the alpha-2 code the calculator expects. */}
              <select
                name="country"
                required
                class="w-full rounded-md border border-line px-3 py-2 bg-surface"
              >
                {destinationChoices.map((c) => (
                  <option value={c.code} selected={c.code === addr.country}>
                    {c.name}
                  </option>
                ))}
              </select>
            </label>
          </div>
          {
            knownCountries.length > 0 && (
              <p class="text-xs text-faint">{t('checkout.shipsTo', { pays: knownCountries.join(', ') })}</p>
            )
          }
          {
            askPhone && (
              <label class="block text-sm">
                <span class="mb-1 block font-medium">{t('checkout.field.phone')}</span>
                <input
                  type="tel"
                  name="phone"
                  value={addr.phone}
                  required
                  autocomplete="tel"
                  aria-describedby="checkout-phone-hint"
                  class="w-full rounded-md border border-line px-3 py-2"
                />
                <span id="checkout-phone-hint" class="mt-1 block text-xs text-faint">{t('checkout.field.phoneHint')}</span>
              </label>
            )
          }
          <button
            type="submit"
            class="w-full rounded-md bg-brand px-4 py-2.5 font-medium text-on-brand hover:bg-brand-hover"
          >
            {t('checkout.continue')} →
          </button>
        </form>
      )
    }
  </div>
</Layout>
