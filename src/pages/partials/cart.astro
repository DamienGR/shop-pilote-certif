---
import { env } from 'cloudflare:workers';
import { formatPrice } from '../../config';
import { readCart, resolveCart, cartCount } from '../../features/cart/cart';
import ProductImage from '../../features/products/ProductImage.astro';
import { getSetting } from '../../features/settings/db';
import { t } from '../../features/i18n';

// Astro partial: renders ONLY this fragment (no surrounding document), so the
// cart drawer can fetch and inject it. Server-rendered, so pricing/stock still
// come from D1 — the drawer holds no client-side cart state.
export const partial = true;
export const prerender = false;

const cart = readCart(Astro.cookies);
const [{ lines, subtotalCents }, imageDeliverySetting] = await Promise.all([
  resolveCart(env.DB, cart),
  getSetting(env.DB, 'image_delivery'),
]);
const imageDelivery = imageDeliverySetting === 'cloudflare' ? 'cloudflare' : 'original';
const count = cartCount(cart);
// As on the cart page: one form owns every quantity field, and "Commander"
// submits it (data-fullpage, so the drawer script lets it navigate), so the
// quantities typed here reach /express instead of the cookie's.
const linesForm = 'drawer-lines';
---

<div data-cart-count={count}>
  {
    lines.length === 0 ? (
      <p class="py-10 text-center text-sm text-muted">
        {t('cart.empty')}
      </p>
    ) : (
      <Fragment>
        <ul class="divide-y divide-line">
          {lines.map((l) => (
            <li class="flex gap-4 py-4">
              <a href={`/products/${l.product.slug}`} class="shrink-0">
                <ProductImage
                  imageKey={l.product.image_key}
                  alt=""
                  sizes="64px"
                  fade
                  usage="thumbnail"
                  delivery={imageDelivery}
                  class="h-16 w-16 rounded object-cover"
                />
              </a>
              <div class="flex flex-1 flex-col">
                <a href={`/products/${l.product.slug}`} class="text-sm leading-snug hover:text-brand">
                  {l.product.name}
                </a>
                {(l.variant || l.extras.length > 0) && (
                  <span class="mt-0.5 text-xs text-muted">
                    {[l.variant?.label, ...l.extras.map((e) => e.label)].filter(Boolean).join(' · ')}
                  </span>
                )}
                <span class="mt-1 text-xs tabular-nums text-muted">
                  {formatPrice(l.unitPriceCents)}
                </span>
                <div class="mt-auto flex items-center gap-4 pt-2">
                  <div class="flex items-center gap-2">
                    <input
                      type="number"
                      form={linesForm}
                      name={`qty:${l.key}`}
                      min="0"
                      max="99"
                      value={l.qty}
                      aria-label={t('cart.quantity')}
                      class="w-12 border-b border-line bg-transparent py-0.5 text-center text-sm tabular-nums focus:border-brand focus:outline-none"
                    />
                    <button
                      type="submit"
                      form={linesForm}
                      class="text-xs uppercase tracking-widest text-faint hover:text-brand"
                    >
                      {t('cart.update')}
                    </button>
                  </div>
                  <form method="POST" action="/api/cart" class="flex items-center">
                    <input type="hidden" name="_action" value="remove" />
                    <input type="hidden" name="key" value={l.key} />
                    <button
                      type="submit"
                      class="text-xs uppercase tracking-widest text-faint hover:text-red-600"
                    >
                      {t('cart.remove')}
                    </button>
                  </form>
                </div>
              </div>
              <span class="shrink-0 text-sm tabular-nums">{formatPrice(l.lineTotalCents)}</span>
            </li>
          ))}
        </ul>

        <div class="mt-6 border-t border-line pt-4">
          <div class="flex items-center justify-between">
            <span class="text-xs uppercase tracking-widest text-muted">{t('cart.subtotal')}</span>
            <span class="text-lg tabular-nums">{formatPrice(subtotalCents)}</span>
          </div>
          <form id={linesForm} method="POST" action="/api/cart">
            <input type="hidden" name="_action" value="update_all" />
            <button
              type="submit"
              name="then"
              value="express"
              data-fullpage
              class="mt-4 block w-full rounded-md bg-brand px-6 py-3 text-center text-sm font-medium uppercase tracking-wider text-on-brand hover:bg-brand-hover"
            >
              {t('cart.checkout')}
            </button>
          </form>
          <a
            href="/cart"
            class="mt-3 block text-center text-xs uppercase tracking-widest text-faint hover:text-brand"
          >
            {t('cart.viewFull')}
          </a>
        </div>
      </Fragment>
    )
  }
</div>
