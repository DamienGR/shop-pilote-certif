---
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { getCategoryBySlug, childrenOf, productsInCategory } from '../../features/categories/db';
import { readCategoryRows } from '../../features/storefront/reads';
import ProductCard from '#theme/ProductCard.astro';
import { buildProductCard } from '../../features/storefront/productCard';
import { getConfig } from '../../config';
import { orderByClause, parseStoreSortQuery } from '../../features/products/sort';
import {
  MAX_PUBLIC_PAGE,
  paginate,
  queryHref,
  requestedPage,
} from '../../pagination';
import Pagination from '../../components/Pagination.astro';
import CatalogSort from '../../features/storefront/controls/CatalogSort.astro';
import { buildSortModel } from '../../features/storefront/catalog';
import { catalogPath } from '../../features/settings/home';
import { addCacheTags, productCacheTags } from '../../features/cache/tags';
import { t } from '../../features/i18n';

const { slug } = Astro.params;
const category = slug ? await getCategoryBySlug(env.DB, slug) : null;

if (!category) {
  // `t` reads as unused to astro check, which stops analysing frontmatter at the
  // first top-level return. It is used — keep the import.
  return new Response(t('http.notFound'), { status: 404 });
}

const { sort, dir } = parseStoreSortQuery(
  Astro.url.searchParams.get('sort'),
  Astro.url.searchParams.get('dir'),
);
const order = orderByClause(sort, dir);

const PAGE_SIZE = 24;
// One D1 batch for everything but the category itself (features/storefront/
// reads.ts); only a page past the end, clamped to the last one, reads again.
const asked = requestedPage(Astro.url.searchParams, MAX_PUBLIC_PAGE);
const read = await readCategoryRows(env.DB, category.id, {
  pageSize: PAGE_SIZE,
  offset: (asked - 1) * PAGE_SIZE,
  order,
});
const { trail, categories, total } = read;
const subcats = childrenOf(categories, category.id);
const { page, offset, totalPages } = paginate(
  Astro.url.searchParams,
  total,
  PAGE_SIZE,
  MAX_PUBLIC_PAGE,
);
const products =
  page === asked
    ? read.products
    : await productsInCategory(env.DB, category.id, PAGE_SIZE, offset, order);
addCacheTags(Astro.response.headers, productCacheTags(products.map((product) => product.public_id)));
// Presentation models are built here, where the store's image settings are
// known; only the first card is the LCP image.
const cards = products.map((product, i) =>
  buildProductCard(product, {
    baseUrl: getConfig().images.baseUrl,
    currency: getConfig().currency,
    delivery: Astro.locals.settings?.imageDelivery,
    sizes: '(min-width: 1024px) 352px, calc(50vw - 36px)',
    priority: i === 0,
  }),
);
const base = `/categories/${category.slug}`;
const hrefFor = (p: number) =>
  queryHref(base, {
    sort: sort === 'newest' ? undefined : sort,
    dir: dir === 'desc' ? undefined : dir,
    page: p > 1 ? p : undefined,
  });
// The catalog is at / until the home page is pointed elsewhere.
const shopHref = catalogPath(Astro.locals.settings?.homePage);
---

<Layout title={category.name}>
  <nav class="mb-4 flex flex-wrap gap-x-2 text-xs uppercase tracking-widest text-faint">
    <a href={shopHref} class="hover:text-brand">{t('shell.nav.store')}</a>
    {
      trail.map((c) => (
        <span class="flex gap-x-2">
          <span aria-hidden="true">/</span>
          <a href={`/categories/${c.slug}`} class="hover:text-brand">
            {c.name}
          </a>
        </span>
      ))
    }
  </nav>

  <h1 class="mb-8 font-serif text-4xl tracking-tight sm:text-5xl">{category.name}</h1>

  {
    subcats.length > 0 && (
      <div class="mb-12 flex flex-wrap gap-x-6 gap-y-2 text-xs uppercase tracking-widest text-muted">
        {subcats.map((c) => (
          <a
            href={`/categories/${c.slug}`}
            class="border-b border-transparent pb-0.5 hover:border-brand hover:text-brand"
          >
            {c.name}
          </a>
        ))}
      </div>
    )
  }

  <CatalogSort model={buildSortModel(base, sort, dir)} />

  {
    /* Same contract as the catalogue's own empty state, which the storefront
       suite pins on every theme: role="status", non-empty. A listing that goes
       silently blank tells a screen-reader user nothing about why — and this
       one was also the last English sentence left on the French storefront. */
    products.length === 0 && (
      <p role="status" class="text-muted">
        {t('catalog.empty.category')}
      </p>
    )
  }

  <ul class="grid grid-cols-2 gap-x-6 gap-y-12 lg:grid-cols-3">
    {
      cards.map((card, i) => (
        <ProductCard card={card} index={i} />
      ))
    }
  </ul>

  <Pagination page={page} totalPages={totalPages} hrefFor={hrefFor} />
</Layout>
