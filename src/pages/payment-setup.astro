---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { t } from '../features/i18n';

// Reached from the cart when a buyer taps a payment method that isn't configured
// yet. It's owner-facing setup help — how to turn that rail on — so the store can
// graduate from Demo to real payments without leaving a dead button.
const method = (Astro.url.searchParams.get('method') ?? '').toLowerCase();
const origin = Astro.url.origin;

interface Guide {
  title: string;
  intro: string;
  steps: string[];
}
const GUIDES: Record<string, Guide> = {
  stripe: {
    title: t('paymentSetup.stripe.title'),
    intro: t('paymentSetup.stripe.intro'),
    steps: [
      t('paymentSetup.stripe.step1'),
      t('paymentSetup.stripe.step2'),
      t('paymentSetup.stripe.step3', { url: `${origin}/api/webhook/stripe` }),
      t('paymentSetup.stripe.step4'),
    ],
  },
  lightning: {
    title: t('paymentSetup.lightning.title'),
    intro: t('paymentSetup.lightning.intro'),
    steps: [
      t('paymentSetup.lightning.step1'),
      t('paymentSetup.lightning.step2'),
      t('paymentSetup.lightning.step3'),
    ],
  },
  opennode: {
    title: t('paymentSetup.opennode.title'),
    intro: t('paymentSetup.opennode.intro'),
    steps: [
      t('paymentSetup.opennode.step1'),
      t('paymentSetup.opennode.step2'),
      t('paymentSetup.opennode.step3', { url: `${origin}/api/webhook/opennode` }),
    ],
  },
};
const guide = GUIDES[method] ?? null;
---

<Layout title={t('paymentSetup.title')} description={t('paymentSetup.description')}>
  <div class="mx-auto max-w-xl py-8">
    <a href="/cart" class="text-xs uppercase tracking-widest text-faint hover:text-accent">
      &larr; {t('paymentSetup.backToCart')}
    </a>

    {
      guide ? (
        <>
          <h1 class="mt-4 font-serif text-3xl tracking-tight">{guide.title}</h1>
          <p class="mt-3 text-muted">{guide.intro}</p>
          <ol class="mt-6 space-y-3">
            {guide.steps.map((s, i) => (
              <li class="flex gap-3 text-sm">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent/10 text-xs font-medium text-accent">
                  {i + 1}
                </span>
                <span class="pt-0.5 text-muted">{s}</span>
              </li>
            ))}
          </ol>
        </>
      ) : (
        <>
          <h1 class="mt-4 font-serif text-3xl tracking-tight">{t('paymentSetup.title')}</h1>
          <p class="mt-3 text-muted">{t('paymentSetup.unconfigured')}</p>
        </>
      )
    }

    <div class="mt-8 rounded-md border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-800">
      {t('paymentSetup.demoNotice.before')}{' '}
      <strong class="font-semibold">{t('paymentSetup.demoNotice.strong')}</strong>{' '}
      {t('paymentSetup.demoNotice.after')}
    </div>
  </div>
</Layout>
