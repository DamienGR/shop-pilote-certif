---
import Layout from '../layouts/Layout.astro';
import { catalogPath } from '../features/settings/home';
import { t } from '../features/i18n';

// Astro renders this for unmatched routes; set the status explicitly so SSR
// responses (and crawlers) get a real 404 rather than a 200.
Astro.response.status = 404;
// The catalog is at / until the home page is pointed elsewhere.
const shopHref = catalogPath(Astro.locals.settings?.homePage);
---

<Layout title={t('notFound.title')} description={t('notFound.description')}>
  <section class="reveal mx-auto max-w-xl py-16 text-center sm:py-24">
    <p class="text-xs uppercase tracking-[0.25em] text-muted">{t('notFound.code')}</p>
    <h1 class="mt-3 font-serif text-5xl tracking-tight sm:text-6xl">{t('notFound.title')}</h1>
    <p class="mx-auto mt-5 max-w-md text-sm text-muted">
      {t('notFound.body')}
    </p>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
      <a
        href={shopHref}
        class="rounded-md bg-brand px-5 py-2.5 text-xs font-medium uppercase tracking-wider text-on-brand transition hover:bg-brand-hover"
      >
        {t('notFound.backToShop')}
      </a>
      <a
        href="/search"
        class="border-b border-transparent pb-0.5 text-xs uppercase tracking-widest text-muted transition hover:border-accent hover:text-accent"
      >
        {t('notFound.searchCatalog')}
      </a>
    </div>
  </section>
</Layout>
