---
import type { StorefrontShellModel } from '../../features/storefront/models';
import StoreNav from '../../features/storefront/controls/StoreNav.astro';
import StoreSearch from '../../features/storefront/controls/StoreSearch.astro';
import StoreCartControl from '../../features/storefront/controls/StoreCartControl.astro';
import StoreAccountControl from '../../features/storefront/controls/StoreAccountControl.astro';
import StoreSearchLink from '../../features/storefront/controls/StoreSearchLink.astro';
import { t } from '../../features/i18n';

/**
 * Studio — a masthead that gets out of the way.
 *
 * The wordmark is the only large thing; everything else is set in small caps at
 * the right edge so the eye drops straight to the work. Not sticky: a gallery
 * does not follow you around the room, and a fixed bar over a dark full-bleed
 * image reads as a smudge.
 *
 * Renders on checkout, the pay page, and Admin login too, so the controls stay
 * as they are.
 */
interface Props {
  model: StorefrontShellModel;
}

const { model } = Astro.props;
const small =
  'text-[10px] font-medium uppercase tracking-[0.24em] text-[color:var(--studio-muted)] hover:text-[color:var(--studio-bone)]';
---

{
  model.announcement && (
    <div class="bg-brand px-4 py-2.5 text-center text-[10px] font-semibold uppercase tracking-[0.2em] text-[color:var(--color-paper)]">
      {model.announcement.href ? (
        <a href={model.announcement.href} class="underline-offset-4 hover:underline">
          {model.announcement.text}
        </a>
      ) : (
        model.announcement.text
      )}
    </div>
  )
}

<header class="border-b border-line">
  <div class="mx-auto flex max-w-[96rem] flex-wrap items-baseline gap-x-10 gap-y-4 px-12 pb-6 pt-8">
    {/* The wordmark is the elastic item and the controls are not, so the
        shrinking has to land here. `shrink-0` did the opposite: it pinned the
        anchor at the name's max-content width, and a merchant called
        "Atelier de céramique de Haute-Provence" pushed the cart off the right
        edge at phone width. Flex shrink is proportional to base size, so the
        nav below also carries `shrink-0` — otherwise it absorbs a share it has
        no way to give back, and overflows on its own. */}
    <a href="/" aria-label={model.storeName} class="min-w-0 truncate">
      {
        model.logo ? (
          <img src={model.logo.src} alt={model.logo.alt} class="h-9 max-w-52 object-contain" />
        ) : (
          <span class="font-serif text-3xl tracking-[-0.02em]">{model.storeName}</span>
        )
      }
    </a>

    <nav aria-label={t('shell.nav.store')} class="ml-auto flex min-w-0 shrink-0 items-center gap-6">
      <StoreNav
        links={model.headerLinks}
        class={`hidden min-w-0 items-center gap-6 xl:flex ${small}`}
        disclosureClass={`relative order-last xl:hidden ${small}`}
      />
      {/* Below sm, icons: the words cut the store name on a phone
          (certification, étape 9). */}
      <StoreSearchLink href={model.search.action} class={`${small} sm:hidden`} />
      {model.account.enabled && <StoreAccountControl href={model.account.href} class={small} iconBelow="sm" />}
      {
        model.cart.enabled && (
          <StoreCartControl
            href={model.cart.href}
            class="inline-flex items-center text-[10px] font-medium uppercase tracking-[0.24em] text-[color:var(--studio-bone)] hover:text-accent"
            iconBelow="sm"
          />
        )
      }
    </nav>

    <StoreSearch
      action={model.search.action}
      query={model.search.query}
      class="hidden w-full border-b border-line pb-1 focus-within:border-brand sm:block sm:w-56"
      inputClass="w-full bg-transparent px-0 py-0.5 text-sm focus:outline-none"
    />
  </div>
</header>
