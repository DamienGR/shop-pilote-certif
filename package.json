{
  "name": "minshop",
  "type": "module",
  "version": "0.3.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DamienGR/minshop-platform.git"
  },
  "bin": {
    "shopctl": "shopctl/bin/shopctl.mjs"
  },
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "dev": "astro dev",
    "shopctl": "node shopctl/bin/shopctl.mjs",
    "build": "astro build",
    "preview": "wrangler dev -c dist/server/wrangler.json --persist-to .wrangler/state",
    "deploy": "node --experimental-strip-types scripts/deploy.mjs",
    "deploy:ci": "node --experimental-strip-types scripts/deploy.mjs --skip-build",
    "check": "npm run theme:sync && astro check",
    "test": "npm run theme:sync && vitest run",
    "test:watch": "vitest",
    "test:integration": "npm run test:security && node --experimental-strip-types test/integration/remote-gates.mjs && node --experimental-strip-types --import ./test/helpers/register-workers-loader.mjs test/integration/settlement.mjs && node --experimental-strip-types test/integration/reservations.mjs && node --experimental-strip-types test/integration/refunds.mjs && node --experimental-strip-types test/integration/media.mjs && node --experimental-strip-types test/integration/menus.mjs && node --experimental-strip-types test/integration/guest-access.mjs && node --experimental-strip-types test/integration/terms.mjs && node --experimental-strip-types test/integration/shipping.mjs && bash test/integration/run-d1-integration.sh",
    "test:d1": "astro build && npm run test:integration",
    "test:storefront-equivalence": "astro build && bash test/integration/storefront-baselines.sh",
    "test:storefront-contract": "vitest run test/storefront",
    "test:catalog": "vitest run test/scripts/catalog.test.mjs",
    "test:tenant-isolation": "vitest run test/scripts/tenant-isolation.test.mjs",
    "test:security": "node --experimental-strip-types test/integration/security.mjs",
    "test:security:remote": "node --experimental-strip-types test/remote/security.mjs",
    "test:load:remote": "node test/remote/load.mjs",
    "test:last-unit:remote": "node test/remote/last-unit.mjs",
    "test:stripe:remote": "node test/remote/stripe-webhook.mjs",
    "test:email:remote": "node test/remote/email.mjs",
    "theme:check": "node scripts/check-themes.mjs",
    "test:browser": "astro build && playwright test",
    "test:browser:remote": "node test/remote/target.mjs && playwright test",
    "verify": "npm run check:toolchain && npm run check:secrets && npm run check:format && npm run config:validate && npm run check:paths && npm run check:release && npm run theme:sync && vitest run && astro check && npm run theme:check && astro build && node scripts/check-built-css.mjs && npm run check:secrets:artifacts && npm run check:deploy && npm run test:integration && node --experimental-strip-types scripts/check-stripe-countries.mjs && npm run mcp:check && npm run scaffold:check",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "check:deploy": "node scripts/check-deploy.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:secrets:artifacts": "node scripts/check-secrets.mjs --artifacts",
    "check:format": "node scripts/check-format.mjs",
    "config:validate": "node scripts/check-manifest.mjs",
    "check:paths": "node scripts/check-paths.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:clean-clone": "bash scripts/check-clean-clone.sh",
    "verify:theme": "node scripts/verify-theme.mjs",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed": "wrangler d1 execute DB --local --file=./seed.sql",
    "provision:cf": "bash scripts/provision-cf.sh",
    "provision:local": "bash scripts/provision-local.sh",
    "destroy:cf": "bash scripts/destroy-cf.sh",
    "destroy:local": "bash scripts/destroy-local.sh",
    "admin:reset": "bash scripts/admin-reset.sh",
    "admin:reset:remote": "bash scripts/admin-reset.sh --remote",
    "reset:local": "bash scripts/reset.sh",
    "reset:remote": "bash scripts/reset.sh --remote",
    "mcp:dev": "wrangler dev --config mcp/wrangler.jsonc --persist-to .wrangler/state",
    "mcp:deploy": "wrangler deploy --config mcp/wrangler.jsonc",
    "mcp:check": "bash scripts/check-mcp.sh",
    "scaffold:check": "npm test --prefix create-minshop && npm pack ./create-minshop --dry-run",
    "theme:sync": "node scripts/theme-sync.mjs",
    "db:seed:storefront-states": "bash scripts/seed-storefront-states.sh"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "astro": "^7.3.8",
    "markdown-it": "^15.0.2",
    "stripe": "^22.6.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "^5.20261008.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "miniflare": "^4.20260730.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.29.0"
    }
  }
}
